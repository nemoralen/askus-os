#!/bin/sh
# ASKus OS — live-build configuration (Debian 13 "trixie", amd64)
set -e

# Used by EVERY boot entry (normal and fail-safe):
#  - no passwordless sudo (sudo), no polkit rule that turns the sudo group into
#    password-less root (policykit), no SSH server
#  - no autologin on the text consoles (Ctrl+Alt+F3 would bypass the lock screen)
#  - the live user is NOT in group debian-tor (that group can reconfigure Tor through
#    its control port, e.g. send all traffic through a proxy that sees the real IP)
COMMON="username=askus user-fullname=ASKus hostname=localhost locales=en_US.UTF-8 keyboard-layouts=us timezone=Etc/UTC \
live-config.nocomponents=sudo,openssh-server,policykit \
live-config.nottyautologin \
live-config.user-default-groups=audio,cdrom,dip,floppy,video,plugdev,netdev,powerdev,scanner,bluetooth,lpadmin \
noswap ipv6.disable=1 \
init_on_alloc=1 init_on_free=1 page_alloc.shuffle=1 slab_nomerge \
randomize_kstack_offset=on vsyscall=none debugfs=off \
mitigations=auto \
nouveau.config=NvGspRm=1"
KPARAMS="boot=live components quiet splash $COMMON"
FAILSAFE="boot=live components $COMMON memtest noapic noapm nodma nomce nosmp nosplash vga=788"

lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --binary-images iso-hybrid \
  --bootloaders "grub-efi,syslinux" \
  --uefi-secure-boot enable \
  --firmware-binary true \
  --firmware-chroot true \
  --linux-packages "linux-image" \
  --linux-flavours amd64 \
  --apt-recommends false \
  --security true \
  --mirror-binary "https://deb.debian.org/debian/" \
  --mirror-binary-security "https://security.debian.org/debian-security/" \
  --updates true \
  --cache-packages true \
  --chroot-squashfs-compression-type zstd \
  --iso-application "ASKus OS" \
  --iso-publisher "ASK Us Design & Consulting" \
  --iso-volume "ASKUS_OS" \
  --image-name "askus-os" \
  --memtest none \
  --bootappend-live "$KPARAMS" \
  --bootappend-live-failsafe "$FAILSAFE" \
  "${@}"

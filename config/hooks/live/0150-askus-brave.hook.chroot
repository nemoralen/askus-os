#!/bin/bash
# Everyday Browser: Brave from Brave's official apt repository (kept in the image so
# ASKus OS can install Brave updates over Tor), plus firejail for sandboxing.
set -u
export DEBIAN_FRONTEND=noninteractive
BRAVE_FPR=D8BAD4DE7EE17AF52A834B2D0BB75829C2D4E821
KEY=/usr/share/keyrings/brave-browser-archive-keyring.gpg

if curl -fsSL -o "$KEY" https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg; then
  GOT=$(gpg --show-keys --with-colons "$KEY" 2>/dev/null | awk -F: '/^fpr/{print $10; exit}')
  echo "[askus] Brave signing key: $GOT"
  [ "$GOT" = "$BRAVE_FPR" ] || echo "[askus] NOTE: Brave key fingerprint differs from the one on file - check https://brave.com/linux/"
  echo "deb [signed-by=$KEY arch=amd64] https://brave-browser-apt-release.s3.brave.com/ stable main" \
    > /etc/apt/sources.list.d/brave-browser-release.list
  apt-get update
  apt-get install -y --no-install-recommends brave-browser || echo "[askus] WARNING: Brave could not be installed"
else
  echo "[askus] WARNING: could not download the Brave signing key - Everyday Browser skipped"
fi
apt-get install -y --no-install-recommends firejail firejail-profiles || apt-get install -y --no-install-recommends firejail || true

# Only the Everyday Browser launcher should appear in the app grid
for f in /usr/share/applications/brave-browser*.desktop /usr/share/applications/com.brave.Browser.desktop; do
  [ -f "$f" ] && ! grep -q '^NoDisplay=true' "$f" && sed -i '/^\[Desktop Entry\]/a NoDisplay=true' "$f"
done
exit 0

#!/bin/bash
# macOS-style look: WhiteSur GTK / GNOME Shell theme, icons and cursors, pulled from GitHub.
# Pinned to reviewed commits: their install scripts run as root inside the image, and the
# result is signed as an ASKus release. To update, review the new commits and change the SHAs.
set -u
export DEBIAN_FRONTEND=noninteractive
GTK_REF=${WHITESUR_GTK_REF:-d5782652d412137e26fb8ff55b55a5572e4c6995}      # 2026-09-11
ICON_REF=${WHITESUR_ICON_REF:-73d8040da51a9ed74e47c7366e7e9ff437601a5c}    # 2026-09-10
CURSOR_REF=${WHITESUR_CURSOR_REF:-e190baf618ed95ee217d2fd45589bd309b37672b}  # 2025-04-05

BUILD_DEPS="git sassc libglib2.0-dev-bin libxml2-utils"
apt-get install -y --no-install-recommends $BUILD_DEPS

# git fetch by commit id: git checks the content against that id
fetch() {   # repo dir ref
  git init -q "$2" && git -C "$2" fetch -q --depth 1 "https://github.com/vinceliuice/$1.git" "$3" &&
    git -C "$2" checkout -q FETCH_HEAD
}
W=/tmp/whitesur; rm -rf $W; mkdir -p $W
for r in "WhiteSur-gtk-theme gtk $GTK_REF" "WhiteSur-icon-theme icons $ICON_REF" "WhiteSur-cursors cursors $CURSOR_REF"; do
  set -- $r
  fetch "$1" "$W/$2" "$3" || { echo "[askus] could not fetch $1 at $3"; exit 1; }
done

# GTK3 + GNOME Shell theme (system-wide)
( cd $W/gtk && ./install.sh -d /usr/share/themes -c dark -c light --silent-mode ) || echo "[askus] WhiteSur GTK install reported an error"

# libadwaita (GTK4) theme: the script refuses to run as root, so run it as nobody and copy into /etc/skel
install -d -o nobody $W/home && cp -r $W/gtk $W/home/gtk && chown -R nobody $W/home
su -s /bin/bash nobody -c "cd $W/home/gtk && HOME=$W/home ./install.sh -l -c dark --silent-mode" || true
if [ -d $W/home/.config/gtk-4.0 ]; then
  mkdir -p /etc/skel/.config && cp -r $W/home/.config/gtk-4.0 /etc/skel/.config/
fi

# Icons and cursors
( cd $W/icons && ./install.sh -d /usr/share/icons ) || echo "[askus] WhiteSur icon install reported an error"
rm -rf /usr/share/icons/WhiteSur-cursors && cp -pr $W/cursors/dist /usr/share/icons/WhiteSur-cursors

for d in /usr/share/icons/WhiteSur*; do gtk-update-icon-cache -f -q "$d" 2>/dev/null || true; done

rm -rf $W
apt-get purge -y $BUILD_DEPS || true
apt-get autoremove -y --purge || true
exit 0

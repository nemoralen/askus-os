#!/bin/bash
# ASKus Coin: node + wallet (a Bitcoin Core fork) and Electrum ASKus, built from
# pinned upstream source commits plus the ASKus patch scripts in this repository.
# Nothing is downloaded as a ready-made binary. If anything fails, it is skipped
# and the rest of the ISO still builds.
set -u
export DEBIAN_FRONTEND=noninteractive
LIB=/usr/local/lib/askus/askuscoin
. "$LIB/PINS"
chmod 0755 /usr/local/bin/askuscoin /usr/local/bin/askuscoin-gui /usr/local/bin/askuscoin-paper-wallet /usr/local/bin/electrum-askus 2>/dev/null
T=$(mktemp -d)
NEW_PKGS=()
cleanup() {
  rm -rf "$T"
  # remove only the build tools this hook installed itself
  [ ${#NEW_PKGS[@]} -gt 0 ] && apt-get purge -y "${NEW_PKGS[@]}" >/dev/null 2>&1
  apt-get autoremove -y >/dev/null 2>&1
}
trap cleanup EXIT
note() { echo "[askus] askuscoin: $*"; }

BUILD_DEPS=(git build-essential cmake pkg-config libboost-dev libevent-dev libsqlite3-dev python3-venv python3-dev autoconf automake libtool)
RUN_DEPS=(libevent-2.1-7t64 libevent-pthreads-2.1-7t64 libsqlite3-0 python3-pyqt6 python3-cryptography python3-pip zenity)
for p in "${BUILD_DEPS[@]}"; do dpkg -s "$p" >/dev/null 2>&1 || NEW_PKGS+=("$p"); done
apt-get install -y --no-install-recommends "${BUILD_DEPS[@]}" ca-certificates >/dev/null || { note "could not install build tools - skipped"; exit 0; }
for p in "${RUN_DEPS[@]}"; do apt-get install -y --no-install-recommends "$p" >/dev/null 2>&1 || note "runtime package $p not available"; done
apt-mark manual "${RUN_DEPS[@]}" >/dev/null 2>&1
apt-get install -y --no-install-recommends libsecp256k1-2 >/dev/null 2>&1 || apt-get install -y --no-install-recommends libsecp256k1-1 >/dev/null 2>&1 || true

fetch() {  # fetch <repo> <tag> <commit> <dir>
  git clone -q --depth 1 --branch "$2" "$1" "$4" || return 1
  [ "$(git -C "$4" rev-parse HEAD)" = "$3" ] || { note "$1 $2 is not the pinned commit - refusing"; return 1; }
}

# ---- 1. Node + wallet (askuscoind / askuscoin-cli / askuscoin-wallet) ----
if fetch "$BITCOIN_REPO" "$BITCOIN_TAG" "$BITCOIN_COMMIT" "$T/core" && python3 -B "$LIB/apply_askus.py" "$T/core"; then
  note "building node (this takes a while)"
  if cmake -S "$T/core" -B "$T/core/build" -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTS=OFF -DBUILD_BENCH=OFF \
       -DBUILD_GUI=OFF -DENABLE_IPC=OFF -DWITH_ZMQ=OFF -DBUILD_FUZZ_BINARY=OFF -DBUILD_WALLET_TOOL=ON \
       -DENABLE_HARDENING=ON >/dev/null &&
     cmake --build "$T/core/build" -j"$(nproc)" >"$T/build.log" 2>&1; then
    install -d /opt/askuscoin/bin
    install -m755 "$T/core/build/bin/bitcoind"       /opt/askuscoin/bin/askuscoind
    install -m755 "$T/core/build/bin/bitcoin-cli"    /opt/askuscoin/bin/askuscoin-cli
    install -m755 "$T/core/build/bin/bitcoin-wallet" /opt/askuscoin/bin/askuscoin-wallet
    strip /opt/askuscoin/bin/* 2>/dev/null
    install -m644 "$T/core/COPYING" /opt/askuscoin/COPYING
    echo "$BITCOIN_TAG+askus" > /opt/askuscoin/ASKUS-VERSION
    note "node installed"
  else
    tail -30 "$T/build.log"; note "node build FAILED - skipped"
  fi
else
  note "node source not available - skipped"
fi

# ---- 2. Electrum ASKus (GUI wallet) ----
if fetch "$ELECTRUM_REPO" "$ELECTRUM_TAG" "$ELECTRUM_COMMIT" "$T/electrum" && python3 -B "$LIB/apply_electrum_askus.py" "$T/electrum"; then
  E=/opt/electrum-askus
  rm -rf "$E"
  # Qt and cryptography come from Debian (security updates); everything else is hash-pinned by Electrum
  # Same method as Electrum's own reproducible build: first its hash-pinned build tools
  # (setuptools, poetry-core, flit-core...), then everything with --no-build-isolation, so pip
  # never fetches an unpinned build tool. aiohttp & co. are built as pure Python (no Cython).
  export AIOHTTP_NO_EXTENSIONS=1 YARL_NO_EXTENSIONS=1 MULTIDICT_NO_EXTENSIONS=1 FROZENLIST_NO_EXTENSIONS=1 PROPCACHE_NO_EXTENSIONS=1
  { python3 -m venv --system-site-packages "$E" &&
    "$E/bin/pip" install --no-cache-dir --require-hashes --no-deps --no-build-isolation -r "$T/electrum/contrib/deterministic-build/requirements-build-base.txt" &&
    "$E/bin/pip" install --no-cache-dir --require-hashes --no-deps --no-build-isolation -r "$T/electrum/contrib/deterministic-build/requirements.txt" &&
    "$E/bin/pip" install --no-cache-dir --no-deps --no-build-isolation "$T/electrum" &&
    ( cd / && "$E/bin/python3" -c "import electrum; from electrum import constants; assert constants.net.SEGWIT_HRP=='ask'" ); } \
    >"$T/electrum.log" 2>&1 &&
  { echo "$ELECTRUM_TAG+askus" > "$E/ASKUS-VERSION"; note "Electrum ASKus installed"; } ||
  { rm -rf "$E"; note "Electrum ASKus install FAILED - skipped. Last lines of the log:"; tail -n 40 "$T/electrum.log" | sed 's/^/[askus]   /'; }
else
  note "Electrum source not available - skipped"
fi
find /opt/electrum-askus -name '__pycache__' -prune -exec rm -rf {} + 2>/dev/null
exit 0

# ===== ASKus OS desktop defaults: macOS-style look, privacy-first =====
[org/gnome/desktop/interface]
gtk-theme='WhiteSur-Dark'
icon-theme='WhiteSur-dark'
cursor-theme='WhiteSur-cursors'
color-scheme='prefer-dark'
accent-color='purple'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='DejaVu Sans Mono 11'
font-antialiasing='rgba'
font-hinting='slight'
enable-hot-corners=false
enable-animations=true
clock-show-weekday=true
clock-show-seconds=false
show-battery-percentage=true

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:appmenu'
titlebar-font='Inter Bold 11'
action-double-click-titlebar='toggle-maximize'

[org/gnome/mutter]
center-new-windows=true
dynamic-workspaces=true
edge-tiling=true

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/askus/askus-wallpaper.png'
picture-uri-dark='file:///usr/share/backgrounds/askus/askus-wallpaper.png'
picture-options='zoom'
primary-color='#070A1F'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/askus/askus-wallpaper.png'
lock-enabled=true

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true
natural-scroll=true
two-finger-scrolling-enabled=true

[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'ubuntu-appindicators@ubuntu.com', 'blur-my-shell@aunetx']
favorite-apps=['askus-tor-browser.desktop', 'askus-everyday-browser.desktop', 'org.gnome.Nautilus.desktop', 'electrum.desktop', 'org.keepassxc.KeePassXC.desktop', 'org.kde.kleopatra.desktop', 'org.mozilla.Thunderbird.desktop', 'thunderbird.desktop', 'askus-tor-status.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Settings.desktop']
welcome-dialog-last-shown-version='999'
disable-user-extensions=false

[org/gnome/shell/extensions/user-theme]
name='WhiteSur-Dark'

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=false
autohide=true
intellihide=true
extend-height=false
dash-max-icon-size=52
icon-size-fixed=false
transparency-mode='DYNAMIC'
background-opacity=0.35
running-indicator-style='DOTS'
custom-theme-shrink=true
apply-custom-theme=false
show-apps-at-top=false
show-trash=true
show-mounts=true
click-action='minimize-or-previews'
scroll-action='cycle-windows'
animation-time=0.15
show-delay=0.05
hide-delay=0.15

[org/gnome/shell/extensions/blur-my-shell]
brightness=0.75
sigma=40

# ---- privacy ----
[org/gnome/desktop/privacy]
remember-recent-files=false
remember-app-usage=false
recent-files-max-age=0
remove-old-temp-files=true
remove-old-trash-files=true
old-files-age=uint32 0
report-technical-problems=false
send-software-usage-stats=false
hide-identity=true
disable-camera=true
disable-microphone=false

[org/gnome/system/location]
enabled=false

[org/gnome/desktop/search-providers]
disable-external=true

[org/gnome/desktop/notifications]
show-in-lock-screen=false

[org/gnome/desktop/media-handling]
automount=true
automount-open=false
autorun-never=true

[org/gnome/desktop/datetime]
automatic-timezone=false

[org/gnome/system/proxy]
mode='none'

[org/gnome/nautilus/preferences]
default-folder-viewer='icon-view'
show-delete-permanently=true

[org/gnome/terminal/legacy]
theme-variant='dark'

[org/gnome/desktop/sound]
event-sounds=false

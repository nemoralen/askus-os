# ===== ASKus OS desktop defaults: macOS-style look, privacy-first =====
[org/gnome/desktop/interface]
gtk-theme='WhiteSur-Dark'
icon-theme='WhiteSur-dark'
cursor-theme='WhiteSur-cursors'
color-scheme='prefer-dark'
accent-color='purple'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='DejaVu Sans Mono 11'
font-antialiasing='rgba'
font-hinting='slight'
enable-hot-corners=false
enable-animations=true
clock-show-weekday=true
clock-show-seconds=false
show-battery-percentage=true

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:appmenu'
titlebar-font='Inter Bold 11'
action-double-click-titlebar='toggle-maximize'

[org/gnome/mutter]
# Sharp text on mixed monitors (e.g. a 4K next to a 1080p): allows 125% / 150% scaling
experimental-features=['scale-monitor-framebuffer', 'xwayland-native-scaling']
center-new-windows=true
dynamic-workspaces=true
edge-tiling=true

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/askus/askus-wallpaper.png'
picture-uri-dark='file:///usr/share/backgrounds/askus/askus-wallpaper.png'
picture-options='zoom'
primary-color='#070A1F'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/askus/askus-wallpaper.png'
# No lock screen until you choose a lock password on the Welcome screen
lock-enabled=false

[org/gnome/desktop/lockdown]
disable-lock-screen=true

[org/gnome/desktop/peripherals/touchpad]
# Right-click like Windows: press the bottom-right corner, or tap with two fingers
click-method='areas'
tap-to-click=true
natural-scroll=true
two-finger-scrolling-enabled=true

[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'ubuntu-appindicators@ubuntu.com', 'blur-my-shell@aunetx', 'ding@rastersoft.com', 'askus-tooltips@askus', 'askus-local-clock@askus', 'clipboard-indicator@tudmotu.com']
favorite-apps=['askus-tor-browser.desktop', 'askus-everyday-browser.desktop', 'askus-assistant.desktop', 'org.gnome.Nautilus.desktop', 'electrum.desktop', 'org.keepassxc.KeePassXC.desktop', 'org.kde.kleopatra.desktop', 'org.mozilla.Thunderbird.desktop', 'thunderbird.desktop', 'askus-tor-status.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Settings.desktop']
welcome-dialog-last-shown-version='999'
disable-user-extensions=false

[org/gnome/shell/extensions/user-theme]
name='WhiteSur-Dark'

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=false
autohide=true
intellihide=true
extend-height=false
dash-max-icon-size=52
icon-size-fixed=false
transparency-mode='DYNAMIC'
background-opacity=0.35
running-indicator-style='DOTS'
custom-theme-shrink=true
apply-custom-theme=false
show-apps-at-top=false
show-trash=true
show-mounts=true
click-action='minimize-or-previews'
scroll-action='cycle-windows'
animation-time=0.15
show-delay=0.05
hide-delay=0.15

[org/gnome/shell/extensions/ding]
show-home=false
show-trash=false
show-volumes=true
show-network-volumes=false
icon-size='standard'
start-corner='top-right'
add-volumes-opposite=true

[org/gnome/shell/extensions/blur-my-shell]
brightness=0.75
sigma=40

# ---- privacy ----
[org/gnome/desktop/privacy]
remember-recent-files=false
remember-app-usage=false
recent-files-max-age=0
remove-old-temp-files=true
remove-old-trash-files=true
old-files-age=uint32 0
report-technical-problems=false
send-software-usage-stats=false
hide-identity=true
disable-camera=true
disable-microphone=false

[org/gnome/system/location]
enabled=false

[org/gnome/desktop/search-providers]
disable-external=true

[org/gnome/desktop/notifications]
show-in-lock-screen=false

[org/gnome/desktop/media-handling]
automount=true
automount-open=false
autorun-never=true

[org/gnome/desktop/datetime]
automatic-timezone=false

[org/gnome/system/proxy]
mode='none'

[org/gnome/nautilus/preferences]
default-folder-viewer='icon-view'
show-delete-permanently=true

[org/gnome/terminal/legacy]
theme-variant='dark'

[org/gnome/desktop/sound]
event-sounds=false

[org/gnome/desktop/a11y]
# Accessibility menu in the top bar: Screen Keyboard (type without a physical keyboard,
# which helps against hardware keyloggers), large text, zoom...
always-show-universal-access-status=true

[org/gnome/settings-daemon/plugins/media-keys]
# Ctrl+Alt+Delete is the ASKus panic key, not the log-out dialog
logout=@as []
# ---- Windows-style shortcuts ----
home=['<Super>e']
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/askus-power/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/askus-sound/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/askus-power]
name='Power menu (like Windows Win+X)'
binding='<Super>x'
command='/usr/local/bin/askus-power-menu'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/askus-sound]
name='Sound output (like Windows Ctrl+Win+V)'
binding='<Primary><Super>v'
command='/usr/local/bin/askus-sound-output'

[org/gnome/shell/keybindings]
# Win+Shift+S: snip an area (also PrintScreen). Saved to Pictures/Screenshots + copied, with a pop-up.
show-screenshot-ui=['Print', '<Shift><Super>s']
# Win+V is the clipboard now; notifications stay on Win+M
toggle-message-tray=['<Super>m']

[org/gnome/desktop/wm/keybindings]
show-desktop=['<Super>d']

[org/gnome/shell/extensions/clipboard-indicator]
# Win+V: clipboard history. Kept in memory only (gone at shutdown), never from password
# managers or wallets, and cleared every hour.
toggle-menu=['<Super>v']
enable-keybindings=true
history-size=25
cache-only-favorites=true
cache-images=false
clear-on-boot=true
clear-history-on-interval=true
clear-history-interval=60
notify-on-copy=false
excluded-apps=['KeePassXC', 'org.keepassxc.KeePassXC', 'keepassxc', 'Electrum', 'electrum', 'feather', 'Feather', 'org.kde.kleopatra', 'kleopatra', 'Kleopatra']

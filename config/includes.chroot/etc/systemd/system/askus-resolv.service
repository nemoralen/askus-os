[Unit]
Description=ASKus OS: send all DNS to Tor
Before=NetworkManager.service network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'rm -f /etc/resolv.conf; printf "nameserver 127.0.0.1\n" > /etc/resolv.conf'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

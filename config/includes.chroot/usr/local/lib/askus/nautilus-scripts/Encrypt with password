#!/bin/bash
# Encrypt the selected files with a password (GnuPG, AES-256). Creates file.gpg next to each.
PW=$(zenity --password --title="Encrypt with password") || exit 0
PW2=$(zenity --password --title="Type the password again") || exit 0
[ "$PW" = "$PW2" ] || { zenity --error --text="The passwords don't match."; exit 1; }
[ ${#PW} -ge 8 ] || { zenity --error --text="Use at least 8 characters."; exit 1; }
n=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  printf '%s' "$PW" | gpg --batch --yes --pinentry-mode loopback --passphrase-fd 0 \
     --symmetric --cipher-algo AES256 -o "$f.gpg" "$f" && n=$((n+1))
done <<< "$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"
notify-send --app-name="ASKus" "Encrypted $n file(s)" "Saved as .gpg next to the originals. The originals were not deleted."

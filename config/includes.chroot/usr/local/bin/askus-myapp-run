#!/bin/bash
# Run one of "My Apps" (~/Persistent/My Apps/<app>) in a sandbox.
#   * NO network by default (the app can't send anything anywhere; web fonts etc. are skipped)
#   * can't see your wallet, GnuPG/SSH keys, KeePassXC, Thunderbird, Tor Browser or Tor itself
#   * web apps open in their own app window (Brave engine); Python apps get the same window
DIR=$1
[ -d "$DIR" ] || { zenity --error --text="App folder not found:\n$DIR"; exit 1; }
DIR=$(readlink -f "$DIR")
NAME=$(basename "$DIR")
SLUG=$(echo "$NAME" | tr 'A-Z' 'a-z' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//')
STATE="$HOME/.local/share/askus-myapps/$SLUG"
mkdir -p "$STATE"

# entry point + network setting (same rules as askus-myapps)
RUN=""; NET=no
if [ -f "$DIR/askus-app.ini" ]; then
  RUN=$(sed -n 's/^[[:space:]]*Run[[:space:]]*=[[:space:]]*//p' "$DIR/askus-app.ini" | head -n1 | tr -d '\r')
  NET=$(sed -n 's/^[[:space:]]*Network[[:space:]]*=[[:space:]]*//p' "$DIR/askus-app.ini" | head -n1 | tr -d '\r' | tr 'A-Z' 'a-z')
fi
if [ -z "$RUN" ]; then
  RUN=$(cd "$DIR" && ls -1 *.pyw 2>/dev/null | head -n1)
  [ -z "$RUN" ] && [ -f "$DIR/index.html" ] && RUN=index.html
  [ -z "$RUN" ] && [ -f "$DIR/main.py" ] && RUN=main.py
fi
[ -n "$RUN" ] && [ -f "$DIR/$RUN" ] || { zenity --error --text="Don't know how to start $NAME\n(no index.html or .pyw found)"; exit 1; }

BROWSER_BIN=$(command -v brave-browser || command -v chromium || command -v brave || true)
WIN=(--class="askus-myapp-$SLUG" --user-data-dir="$STATE/window" --no-first-run --no-default-browser-check
     --disable-sync --disable-background-networking --window-size=1280,860)

# Python apps import pymupdf; older Debian builds call it "fitz" - provide the new name if needed
PYPATH="$DIR"
python3 -c 'import pymupdf' 2>/dev/null || { python3 -c 'import fitz' 2>/dev/null && PYPATH="$DIR:/usr/local/lib/askus/pyshim"; }

JAIL=(firejail --quiet --noprofile --name="myapp-$SLUG" --caps.drop=all --seccomp --nonewprivs --nogroups
      --blacklist="$HOME/.gnupg" --blacklist="$HOME/.ssh" --blacklist="$HOME/.electrum"
      --blacklist="$HOME/.config/keepassxc" --blacklist="$HOME/.thunderbird" --blacklist="$HOME/.tor-browser"
      --blacklist="$HOME/Persistent/.everyday-browser" --blacklist="$HOME/Persistent/.askus-assistant"
      --blacklist=/opt/tor-browser --blacklist=/etc/tor --blacklist=/run/askus --blacklist=/run/askus-tor
      --blacklist=/run/live --blacklist=/etc/NetworkManager/system-connections)
[ "$NET" = yes ] || JAIL+=(--net=none)
command -v firejail >/dev/null 2>&1 || JAIL=()

case "$RUN" in
  *.html|*.htm)
    [ -n "$BROWSER_BIN" ] || { xdg-open "$DIR/$RUN"; exit 0; }
    URI=$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).as_uri())' "$DIR/$RUN")
    exec "${JAIL[@]}" "$BROWSER_BIN" "${WIN[@]}" --allow-file-access-from-files --app="$URI"
    ;;
  *)
    cd "$DIR" || exit 1
    if [ -n "$BROWSER_BIN" ]; then
      # Python apps that open their window with Python's webbrowser module get an app window
      export BROWSER="$BROWSER_BIN ${WIN[*]} --app=%s"
    fi
    exec "${JAIL[@]}" env PYTHONPATH="$PYPATH" python3 "$DIR/$RUN"
    ;;
esac

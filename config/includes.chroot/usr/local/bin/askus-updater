#!/usr/bin/python3
"""ASKus Update: check for and install the newest weekly ASKus OS build."""
import json
import subprocess
import sys

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

HELPER = "/usr/local/sbin/askus-update"
LOGO = "/usr/share/icons/hicolor/256x256/apps/askus-logo.png"


def run_async(argv, callback):
    try:
        proc = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE)
    except GLib.Error as e:
        callback(False, "", e.message)
        return

    def done(p, res):
        try:
            _, out, err = p.communicate_utf8_finish(res)
        except GLib.Error as e:
            callback(False, "", e.message)
            return
        callback(p.get_successful(), out or "", err or "")
    proc.communicate_utf8_async(None, None, done)


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="ASKus Update")
        self.set_default_size(520, 560)
        self.polling = False
        self.latest = None

        self.toasts = Adw.ToastOverlay()
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18,
                      margin_top=12, margin_bottom=24, margin_start=18, margin_end=18)

        logo = Gtk.Image.new_from_file(LOGO)
        logo.set_pixel_size(96)
        box.append(logo)
        self.title = Gtk.Label(label="Checking for updates…")
        self.title.add_css_class("title-2")
        box.append(self.title)

        group = Adw.PreferencesGroup()
        self.row_installed = Adw.ActionRow(title="Installed", subtitle="…")
        self.row_latest = Adw.ActionRow(title="Newest available", subtitle="…")
        group.add(self.row_installed)
        group.add(self.row_latest)
        box.append(group)

        self.progress = Gtk.ProgressBar(show_text=True, visible=False)
        box.append(self.progress)
        self.step = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER)
        self.step.add_css_class("dim-label")
        box.append(self.step)

        self.button = Gtk.Button(label="Check again", halign=Gtk.Align.CENTER)
        self.button.add_css_class("pill")
        self.button.add_css_class("suggested-action")
        self.button.connect("clicked", self.on_button)
        box.append(self.button)

        note = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER,
                         label="Updates are downloaded through Tor and checked with SHA-256 before anything is "
                               "written. Your Persistent Storage is kept.")
        note.add_css_class("caption")
        note.add_css_class("dim-label")
        box.append(note)

        view.set_content(box)
        self.toasts.set_child(view)
        self.set_content(self.toasts)

        # resume showing progress if an update is already running
        run_async([HELPER, "status"], self.on_initial_status)

    # ---------------------------------------------------------------
    def on_initial_status(self, ok, out, err):
        try:
            st = json.loads(out)
        except ValueError:
            st = {}
        if st.get("state") == "running":
            self.start_polling()
        else:
            self.check()

    def check(self):
        self.mode = "check"
        self.title.set_label("Checking for updates…")
        self.button.set_sensitive(False)
        run_async([HELPER, "check", "--json"], self.on_check)

    def on_check(self, ok, out, err):
        self.button.set_sensitive(True)
        try:
            r = json.loads(out)
        except ValueError:
            r = {"ok": False, "error": err.strip() or "Could not check for updates"}
        self.row_installed.set_subtitle(r.get("current", "?"))
        if not r.get("ok"):
            self.title.set_label("Can't check right now")
            self.step.set_label(r.get("error", "") + "\nMake sure you're connected to Tor.")
            self.row_latest.set_subtitle("—")
            self.mode = "check"
            self.button.set_label("Check again")
            return
        self.row_latest.set_subtitle(f"{r['latest']}  ·  {r.get('size', 0)/1e9:.1f} GB")
        if r.get("newer"):
            self.latest = r["latest"]
            self.title.set_label("An update is available")
            self.step.set_label("The download can take 10–40 minutes over Tor. Keep the USB stick plugged in.")
            self.mode = "update"
            self.button.set_label("Update now")
        else:
            self.title.set_label("ASKus OS is up to date ✓")
            self.step.set_label("")
            self.mode = "check"
            self.button.set_label("Check again")

    def on_button(self, _b):
        if self.mode == "check":
            self.check()
        elif self.mode == "update":
            self.confirm_update()
        elif self.mode == "reboot":
            subprocess.Popen(["systemctl", "reboot"])

    def confirm_update(self):
        dlg = Adw.AlertDialog(
            heading=f"Install {self.latest}?",
            body="ASKus OS will download the new version through Tor, verify it, and write it to this USB stick. "
                 "Keep the computer on and the USB stick plugged in until it says it's finished. "
                 "Your Persistent Storage is kept.")
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("go", "Update")
        dlg.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED)
        dlg.connect("response", lambda d, r: r == "go" and self.start_update())
        dlg.present(self)

    def start_update(self):
        self.button.set_sensitive(False)
        run_async(["pkexec", HELPER, "start"],
                  lambda ok, o, e: self.start_polling() if ok else self.show_error(e.strip() or "Could not start"))

    def start_polling(self):
        self.title.set_label("Updating ASKus OS…")
        self.progress.set_visible(True)
        self.button.set_sensitive(False)
        self.button.set_label("Updating…")
        if not self.polling:
            self.polling = True
            GLib.timeout_add(1000, self.poll)

    def poll(self):
        run_async([HELPER, "status"], self.on_status)
        return self.polling

    def on_status(self, ok, out, err):
        try:
            st = json.loads(out)
        except ValueError:
            return
        self.progress.set_fraction(min(1, float(st.get("progress", 0)) / 100))
        self.progress.set_text(f"{st.get('progress', 0):.0f}%")
        self.step.set_label(st.get("step", ""))
        if st.get("state") == "done":
            self.polling = False
            self.progress.set_fraction(1)
            if st.get("reboot"):
                self.title.set_label("Update installed ✓")
                self.mode = "reboot"
                self.button.set_label("Restart now")
            else:
                self.title.set_label("ASKus OS is up to date ✓")
                self.mode = "check"
                self.button.set_label("Check again")
            self.button.set_sensitive(True)
        elif st.get("state") == "error":
            self.polling = False
            self.show_error(st.get("error", "The update failed"))

    def show_error(self, msg):
        self.title.set_label("The update didn't finish")
        self.step.set_label(msg)
        self.progress.set_visible(False)
        self.mode = "check"
        self.button.set_label("Check again")
        self.button.set_sensitive(True)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.askus.Update")

    def do_activate(self):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.PREFER_DARK)
        (self.props.active_window or Window(self)).present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))

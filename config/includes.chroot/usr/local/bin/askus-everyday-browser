#!/bin/bash
# Everyday Browser: Brave in a firejail sandbox, separate from Tor Browser and from
# your Persistent files, wallet and keys. Its traffic still goes through Tor.
#   askus-everyday-browser          forgets everything when you close it
#   askus-everyday-browser --keep   keeps logins/bookmarks in Persistent Storage
MODE=forget
if [ "${1:-}" = "--keep" ]; then MODE=keep; shift; fi

if ! command -v brave-browser >/dev/null 2>&1; then
  zenity --error --title="Everyday Browser" --text="Brave is not installed in this ASKus OS build."
  exit 1
fi

# Once per session: what this browser is (and isn't) for.
NOTE="${XDG_RUNTIME_DIR:-/tmp}/askus-everyday-browser-noted"
if [ ! -e "$NOTE" ]; then
  zenity --info --title="Everyday Browser" --width=420 \
    --text="The Everyday Browser is for normal websites where you log in as yourself (email, banking, shopping).\n\nIts traffic goes through Tor, but Brave is <b>not</b> built for anonymity: websites can recognise it.\n\nFor anything anonymous, and for every <b>.onion</b> site, use <b>Tor Browser</b>." || true
  touch "$NOTE"
fi

if [ "$MODE" = keep ]; then
  if mountpoint -q "$HOME/Persistent"; then
    DIR="$HOME/Persistent/.everyday-browser"
  else
    zenity --warning --title="Everyday Browser" --width=380 \
      --text="To keep your logins, unlock Persistent Storage on the Welcome screen at startup.\n\nOpening in <b>forget mode</b> instead (nothing is saved)."
    MODE=forget
  fi
fi
if [ "$MODE" = forget ]; then
  DIR=$(mktemp -d /tmp/everyday-browser.XXXXXX)
  trap 'rm -rf "$DIR"' EXIT
fi
mkdir -p "$DIR/Downloads"
chmod 700 "$DIR"

# Edge-style layout on every new profile, and once on an existing one: vertical tabs on the
# left, sidebar always shown on the right, bookmarks bar shown. Only settings you haven't
# chosen yourself are filled in, so changes you make in Brave are kept.
seed_prefs() {
  python3 - "$1" <<'PY'
import json, os, sys
path = sys.argv[1]
os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
try:
    with open(path) as f:
        prefs = json.load(f)
except (OSError, ValueError):
    prefs = {}
if prefs.get("askus", {}).get("layout_seeded"):
    sys.exit(0)
def put(keys, value):
    d = prefs
    for k in keys[:-1]:
        d = d.setdefault(k, {})
    d.setdefault(keys[-1], value)
put(["brave", "tabs", "vertical_tabs_enabled"], True)
put(["brave", "tabs", "vertical_tabs_on_right"], False)
put(["brave", "sidebar", "sidebar_show_option"], 0)        # 0 = always show
put(["side_panel", "is_right_aligned"], True)
put(["bookmark_bar", "show_on_all_tabs"], True)
prefs.setdefault("askus", {})["layout_seeded"] = True
tmp = path + ".askus-tmp"
with open(tmp, "w") as f:
    json.dump(prefs, f)
os.replace(tmp, path)
PY
}
if command -v firejail >/dev/null 2>&1; then
  seed_prefs "$DIR/.config/BraveSoftware/Brave-Browser/Default/Preferences"   # home inside the sandbox = $DIR
else
  seed_prefs "$DIR/profile/Default/Preferences"
fi

if command -v firejail >/dev/null 2>&1; then
  PROFILE=/etc/firejail/brave.profile
  [ -f "$PROFILE" ] && P=(--profile="$PROFILE") || P=()
  firejail --quiet "${P[@]}" --private="$DIR" \
    --blacklist=/run/askus --blacklist=/run/askus-tor --blacklist=/opt/tor-browser --blacklist=/etc/tor --blacklist=/run/live \
    brave-browser --class=EverydayBrowser --no-default-browser-check --no-first-run "$@"
else
  brave-browser --class=EverydayBrowser --user-data-dir="$DIR/profile" \
    --no-default-browser-check --no-first-run "$@"
fi

#!/usr/bin/python3
"""ASKus OS app window: shows one of "My Apps" in its own native window (no browser).

  askus-appwindow --id ID --title TITLE [--icon PNG] [--data DIR] [--open FILE]... URL

* Uses the system's WebKitGTK engine, whose page process runs in its own bubblewrap sandbox.
* Offline: every connection except to this computer (file:// pages, 127.0.0.1) is sent to
  a dead proxy, so the app can't reach the internet - not even through Tor.
* Links to other websites are not opened. Files the app wants to save get a normal Save
  dialog. Settings the app keeps (localStorage) are stored in --data (in the app's own
  folder in Persistent Storage, so they survive a restart).
* If URL is a file that isn't a web page (e.g. a finished PDF), it opens in its normal app.
* --open FILE: hand documents to the app as if they were dropped on its window. If the app
  is already open, they go to that window (one window per app, a new tab in the app).
"""
import argparse
import json
import os
import pathlib
import re
import subprocess
import sys
from urllib.parse import unquote, urlparse

import gi


def webkit_sandbox_works():
    """WebKit runs web pages in its own bubblewrap sandbox. Inside firejail (how My Apps are
    started) bubblewrap usually can't create its namespaces; then firejail is the sandbox."""
    if os.environ.get("container") != "firejail":
        return True
    try:
        return subprocess.run(["bwrap", "--ro-bind", "/", "/", "--dev", "/dev", "--unshare-user", "true"],
                              capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


if not webkit_sandbox_works():
    os.environ["WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS"] = "1"

gi.require_version("Gtk", "4.0")
gi.require_version("WebKit", "6.0")
from gi.repository import Gio, GLib, Gtk, WebKit  # noqa: E402

LOCAL_HOSTS = ("127.0.0.1", "localhost", "::1")


def is_local(uri):
    u = urlparse(uri)
    if u.scheme in ("file", "blob", "data", "about"):
        return True
    return u.scheme in ("http", "https") and (u.hostname or "") in LOCAL_HOSTS


def is_page(uri):
    u = urlparse(uri)
    if u.scheme in ("http", "https"):
        return True
    return u.scheme == "file" and unquote(u.path).lower().endswith((".html", ".htm"))


def open_outside(uri):
    """Hand a non-page local file (PDF, folder...) to its normal app."""
    u = urlparse(uri)
    if u.scheme == "file":
        subprocess.Popen(["xdg-open", unquote(u.path)])


# Hands files to the page exactly like a drag-and-drop onto the middle of the window.
DROP_JS = """
const out = [];
for (const p of JSON.parse(files)) {
  const buf = await new Promise((ok, bad) => {
    const x = new XMLHttpRequest(); x.open('GET', p.url); x.responseType = 'arraybuffer';
    x.onload = () => ok(x.response); x.onerror = () => bad(new Error('cannot read ' + p.name)); x.send();
  });
  out.push(new File([buf], p.name, {type: p.type}));
}
const dt = new DataTransfer();
for (const f of out) dt.items.add(f);
const el = document.elementFromPoint(innerWidth / 2, innerHeight / 2) || document.body;
for (const t of ['dragenter', 'dragover', 'drop'])
  el.dispatchEvent(new DragEvent(t, {bubbles: true, cancelable: true, dataTransfer: dt}));
return out.length;
"""


def app_id(window_id):
    """D-Bus/Wayland id for the app (one running copy per app). askus-myapps uses the same."""
    return "org.askus.MyApp." + re.sub(r"[^A-Za-z0-9_]", "_", window_id)


class AppWindow(Gtk.Application):
    def __init__(self, a):
        super().__init__(application_id=app_id(a.id), flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.a = a
        self.to_open = set()
        self.stubs = []
        self.loaded = False
        self.pending = list(a.open or [])

    def do_open(self, files, _n, _hint):
        # a second launch with documents (double-click while the app is open)
        self.pending += [f.get_path() for f in files if f.get_path()]
        self.do_activate()
        self.deliver()

    def on_load(self, _view, event):
        if event == WebKit.LoadEvent.FINISHED and not self.loaded:
            self.loaded = True
            GLib.timeout_add(1500, lambda: (self.deliver(), False)[1])   # let the app finish starting

    def deliver(self):
        if not self.loaded or not self.pending or not self.a.url.startswith("file:"):
            return
        files = [{"url": pathlib.Path(p).resolve().as_uri(), "name": os.path.basename(p),
                  "type": "application/pdf" if p.lower().endswith(".pdf") else ""}
                 for p in self.pending if os.path.isfile(p)]
        self.pending = []
        if files:
            self.view.call_async_javascript_function(DROP_JS, -1, GLib.Variant("a{sv}", {
                "files": GLib.Variant("s", json.dumps(files))}), None, None, None, None)

    def do_activate(self):
        if getattr(self, "win", None):         # already open: bring it to the front
            self.win.present()
            return
        a = self.a
        data = a.data or os.path.join(GLib.get_user_data_dir(), "askus-appwindow", a.id)
        os.makedirs(data, mode=0o700, exist_ok=True)
        session = WebKit.NetworkSession.new(os.path.join(data, "data"), os.path.join(data, "cache"))
        # Offline: everything except this computer goes to a proxy that doesn't exist.
        proxy = WebKit.NetworkProxySettings.new("http://127.0.0.1:9", list(LOCAL_HOSTS))
        session.set_proxy_settings(WebKit.NetworkProxyMode.CUSTOM, proxy)
        session.connect("download-started", self.on_download)

        view = WebKit.WebView(network_session=session)
        s = view.get_settings()
        s.set_allow_file_access_from_file_urls(True)        # the app's own files (pdf.js worker...)
        # An app made of local files (file://) may talk to its own other windows - e.g. Norbert
        # Desk hands an open PDF to the window it pops out (window.opener), as in Chrome/Edge.
        # It still can't reach the internet (dead proxy above; no network at all in firejail).
        s.set_allow_universal_access_from_file_urls(a.url.startswith("file:"))
        s.set_enable_developer_extras(False)
        s.set_javascript_can_open_windows_automatically(True)   # on_create decides what really happens
        s.set_enable_back_forward_navigation_gestures(False)
        view.connect("decide-policy", self.on_policy)
        view.connect("create", self.on_create)
        view.connect("close", lambda _v: self.win.destroy())
        view.connect("load-changed", self.on_load)
        view.connect("notify::title", lambda v, _p: self.win.set_title(v.get_title() or a.title))

        self.win = Gtk.ApplicationWindow(application=self, title=a.title)
        self.win.set_default_size(1280, 860)
        if a.icon and os.path.isfile(a.icon):
            # GNOME shows the icon from the app's .desktop entry; this covers other cases
            theme = Gtk.IconTheme.get_for_display(self.win.get_display())
            theme.add_search_path(os.path.dirname(a.icon))
            self.win.set_icon_name(os.path.splitext(os.path.basename(a.icon))[0])
        self.win.set_child(view)
        self.win.present()
        self.view = view
        view.load_uri(a.url)

    def on_policy(self, _view, decision, kind):
        if kind in (WebKit.PolicyDecisionType.NAVIGATION_ACTION, WebKit.PolicyDecisionType.NEW_WINDOW_ACTION):
            uri = decision.get_navigation_action().get_request().get_uri()
            if not is_local(uri):
                decision.ignore()            # stays offline; external links are not opened
                return True
            if kind == WebKit.PolicyDecisionType.NEW_WINDOW_ACTION and not is_page(uri):
                decision.ignore()
                open_outside(uri)
                return True
            # a page of the app in a new window: allowed - on_create opens a real second window
        elif kind == WebKit.PolicyDecisionType.RESPONSE:
            if not decision.is_mime_type_supported():
                decision.download()          # e.g. a PDF: offer to save it
                return True
        return False

    def on_create(self, _view, action):
        uri = action.get_request().get_uri()
        if is_local(uri):
            if is_page(uri):
                # e.g. Norbert Desk's "Open in new window": a real second window, so the
                # first one (and its open documents) stays as it is.
                return self.new_window(_view)
            elif uri.startswith("blob:"):
                # e.g. "Print": the app made a PDF in memory - open it in the PDF viewer
                self.to_open.add(uri)
                self.view.download_uri(uri)
                # Give the page a window object (never shown) so it doesn't report
                # "pop-up blocked"; it loads nothing.
                stub = WebKit.WebView(related_view=self.view)
                stub.connect("decide-policy", self.on_stub_policy)
                self.stubs.append(stub)
                GLib.timeout_add_seconds(60, self.drop_stub, stub)
                return stub
            else:
                open_outside(uri)
        return None                          # never open extra windows

    def new_window(self, opener):
        view = WebKit.WebView(related_view=opener)   # same offline session and app data
        view.set_settings(opener.get_settings())      # same rules as the first window
        view.connect("decide-policy", self.on_policy)
        view.connect("create", self.on_create)
        win = Gtk.ApplicationWindow(application=self, title=self.a.title)
        win.set_default_size(1200, 900)
        win.set_child(view)
        view.connect("notify::title", lambda v, _p: win.set_title(v.get_title() or self.a.title))
        view.connect("ready-to-show", lambda _v: win.present())
        view.connect("close", lambda _v: win.destroy())     # the page called window.close()
        return view

    def on_stub_policy(self, _view, decision, _kind):
        decision.ignore()
        return True

    def drop_stub(self, stub):
        if stub in self.stubs:
            self.stubs.remove(stub)
        return False

    def on_download(self, _session, download):
        download.connect("decide-destination", self.on_destination)

    def on_destination(self, download, suggested):
        uri = download.get_request().get_uri()
        if uri in self.to_open:              # open, don't ask where to save
            self.to_open.discard(uri)
            tmp = os.path.join(GLib.get_user_runtime_dir(), "askus-appwindow")
            os.makedirs(tmp, mode=0o700, exist_ok=True)
            path = os.path.join(tmp, suggested or "document.pdf")
            download.set_allow_overwrite(True)
            download.set_destination(path)
            download.connect("finished", lambda _d: subprocess.Popen(["xdg-open", path]))
            return True
        return self.ask_destination(download, suggested)

    def ask_destination(self, download, suggested):
        dialog = Gtk.FileDialog(title="Save", initial_name=suggested or "download")
        # Start in Persistent Storage when it's unlocked: other folders are erased at shutdown.
        start = os.path.join(GLib.get_home_dir(), "Persistent")
        if not os.path.ismount(start):
            start = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS) or GLib.get_home_dir()
        dialog.set_initial_folder(Gio.File.new_for_path(start))

        def done(dlg, res):
            try:
                f = dlg.save_finish(res)
            except GLib.Error:
                download.cancel()
                return
            download.set_allow_overwrite(True)   # the Save dialog already asked about replacing
            download.set_destination(f.get_path())

        dialog.save(self.win, None, done)
        return True


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--id", required=True)
    p.add_argument("--title", default="App")
    p.add_argument("--icon")
    p.add_argument("--data")
    p.add_argument("--open", action="append", default=[])
    p.add_argument("url")
    a = p.parse_args()
    if not is_local(a.url):
        sys.exit("askus-appwindow only opens files and pages on this computer")
    if not is_page(a.url):
        open_outside(a.url)
        return 0
    GLib.set_prgname(a.id)
    GLib.set_application_name(a.title)
    app = AppWindow(a)
    try:
        app.register(None)
    except GLib.Error:
        pass
    if app.get_is_remote():                  # the app is already open: hand over and quit
        if a.open:
            app.open([Gio.File.new_for_path(p) for p in a.open], "")
        else:
            app.activate()
        return 0
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())

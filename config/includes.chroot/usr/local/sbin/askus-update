#!/usr/bin/python3
"""ASKus OS updater.

  askus-update check [--json]   is a newer signed build available? (any user)
  askus-update status           progress of a running update (any user)
  askus-update start            start updating in the background (root, via pkexec)
  askus-update apply            the update itself (run by `start` as a systemd unit)
  askus-update prefetch         download a newer signed release in the background (timer)

How an update works:
  1. The newest GitHub Release of UPDATE_REPO (see /etc/askus-release) is fetched
     through Tor, and the image (one .iso or .iso.partNN pieces) is put together in
     Persistent Storage if it's unlocked, otherwise in RAM. FAST (DELTA) UPDATE: the
     release's chunk index (.iso.index.gz) is compared with the index of the version
     on this stick; every unchanged chunk is copied from the stick (and checked against
     its SHA-256 fingerprint) and only the changed chunks are downloaded, over 8 Tor
     circuits at once. If that isn't possible, the whole image is downloaded.
  2. Its SHA-256 is checked against the release's SHA256SUMS, which must be signed with
     the ASKus release key. The version is taken from that signed file (not from the
     release tag), so an older signed image can't be passed off as an update.
  3. The running system is moved off the USB stick: its squashfs is copied into RAM
     and the loop device is switched over to the copy (LOOP_CHANGE_FD).
  4. The new image is written to the start of the stick, read back and verified, and
     the Persistent Storage partition entry (which starts at 4 GiB, behind the
     image area) is restored, so saved data is kept.
  5. Restart to boot the new version.
"""
import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import urllib.request

RELEASE_FILE = "/etc/askus-release"
STATUS = "/run/askus/update.json"
MEDIUM = "/run/live/medium"
SQUASHFS = MEDIUM + "/live/filesystem.squashfs"
PERSIST_LABEL = "ASKusPersistence"
PERSIST_MNT = "/run/askus/persistence"
RAM_DIR = "/run/askus/update-ram"
SQUASH_RAM = "/run/askus/rootfs-ram"
TOR = "socks5h://127.0.0.1:9050"
LOOP_CHANGE_FD = 0x4C06
BLKFLSBUF = 0x1261
CHUNK = 4 * 1024 * 1024


# ---------------------------------------------------------------- helpers
def release_info():
    info = {"VERSION": "1.0", "BUILD_ID": "0", "TAG": "dev", "UPDATE_REPO": "nemoralen/askus-os"}
    try:
        for line in open(RELEASE_FILE):
            if "=" in line:
                k, v = line.strip().split("=", 1)
                info[k] = v
    except OSError:
        pass
    return info


def build_id_of(tag):
    m = re.search(r"(\d{12})", tag or "")
    return int(m.group(1)) if m else 0


def curl(args, timeout=60):
    cmd = ["curl", "-fsSL", "--proxy", TOR, "--retry", "3", "--max-time", str(timeout),
           "-H", "User-Agent: askus-update"] + args
    return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout


def latest_release(repo):
    data = json.loads(curl([f"https://api.github.com/repos/{repo}/releases/latest"]))
    assets = [{"name": a["name"], "url": a["browser_download_url"], "size": a["size"]}
              for a in data.get("assets", [])]
    return data["tag_name"], data.get("published_at", ""), assets


def image_assets(assets):
    """Return (iso_name, [pieces in order], SHA256SUMS asset)."""
    sums = next((a for a in assets if a["name"] == "SHA256SUMS"), None)
    whole = [a for a in assets if a["name"].endswith(".iso")]
    parts = sorted([a for a in assets if re.search(r"\.iso\.part\d+$", a["name"])],
                   key=lambda a: a["name"])
    if whole:
        return whole[0]["name"], whole[:1], sums
    if parts:
        return re.sub(r"\.part\d+$", "", parts[0]["name"]), parts, sums
    return None, [], sums


def write_status(**kw):
    kw["time"] = int(time.time())
    os.makedirs(os.path.dirname(STATUS), exist_ok=True)
    tmp = STATUS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(kw, f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, STATUS)


def sh(*cmd, **kw):
    return subprocess.run(list(cmd), capture_output=True, text=True, **kw)


def boot_disk():
    src = sh("findmnt", "-no", "SOURCE", MEDIUM).stdout.strip()
    if not src:  # started with "toram": find the stick by its volume label
        devs = sh("blkid", "-t", "LABEL=ASKUS_OS", "-o", "device").stdout.split()
        devs = [d for d in devs if not d.startswith("/dev/sr")]
        src = devs[0] if devs else ""
    if not src or src.startswith(("/dev/sr", "/dev/loop")):
        return None
    pk = sh("lsblk", "-no", "PKNAME", src).stdout.split()
    return "/dev/" + pk[0] if pk else None


def persistence_partition(disk):
    """(device, start_sector, size_sectors) of the LUKS Persistent Storage, or None."""
    out = sh("lsblk", "-lnpo", "NAME,TYPE", disk).stdout.split("\n")
    for line in out:
        f = line.split()
        if len(f) == 2 and f[1] == "part":
            p = f[0]
            if (sh("blkid", "-s", "TYPE", "-o", "value", p).stdout.strip() == "crypto_LUKS" and
                    sh("blkid", "-s", "LABEL", "-o", "value", p).stdout.strip() == PERSIST_LABEL):
                name = os.path.basename(p)
                start = int(open(f"/sys/class/block/{name}/start").read())
                size = int(open(f"/sys/class/block/{name}/size").read())
                return p, start, size
    return None


def mem_available():
    for line in open("/proc/meminfo"):
        if line.startswith("MemAvailable:"):
            return int(line.split()[1]) * 1024
    return 0


# ---------------------------------------------------------------- commands
def cmd_check(as_json):
    cur = release_info()
    try:
        tag, published, assets = latest_release(cur["UPDATE_REPO"])
    except Exception as e:  # noqa: BLE001
        res = {"ok": False, "error": f"could not reach the update server through Tor ({e.__class__.__name__})",
               "current": cur["TAG"]}
        print(json.dumps(res) if as_json else res["error"])
        return 2
    name, pieces, _ = image_assets(assets)
    newer = build_id_of(tag) > build_id_of(cur["TAG"]) and bool(pieces)
    if newer:
        try:
            signed_image(assets, tag, cur["TAG"])
        except Exception as e:  # noqa: BLE001
            res = {"ok": False, "current": cur["TAG"], "latest": tag,
                   "error": str(e) if isinstance(e, Failure) else
                   f"could not check the update's signature ({e.__class__.__name__})"}
            print(json.dumps(res) if as_json else res["error"])
            return 3
    res = {"ok": True, "current": cur["TAG"], "latest": tag, "published": published,
           "newer": newer, "size": sum(p["size"] for p in pieces)}
    if as_json:
        print(json.dumps(res))
    else:
        print(f"installed: {cur['TAG']}\nlatest:    {tag} ({published})")
        print("an update is available" if newer else "ASKus OS is up to date")
    return 0


def cmd_status():
    try:
        print(open(STATUS).read())
    except OSError:
        print(json.dumps({"state": "idle"}))
    return 0


def cmd_start():
    if os.geteuid() != 0:
        sys.exit("must run as root (pkexec askus-update start)")
    if sh("systemctl", "is-active", "--quiet", "askus-update.service").returncode == 0:
        print("already running")
        return 0
    write_status(state="running", step="Starting…", progress=0)
    sh("systemctl", "stop", "askus-update-prefetch.service")   # the update continues its download
    sh("systemctl", "reset-failed", "askus-update.service")
    r = sh("systemd-run", "--unit=askus-update", "--collect", "--quiet",
           "--property=Type=exec", "/usr/local/sbin/askus-update", "apply")
    if r.returncode != 0:
        write_status(state="error", error=r.stderr.strip() or "could not start the updater")
        return 1
    print("started")
    return 0


class Failure(Exception):
    pass


SIGNERS = "/etc/askus/release-signers"   # public key(s) allowed to sign releases
SIG_NAMESPACE = "askus-release"


def verified_sums(assets):
    """Download SHA256SUMS and check its signature against the ASKus release key.
    Returns the SHA256SUMS text, or raises Failure. An update that is not signed with
    the key built into this system is never installed."""
    sums = next((a for a in assets if a["name"] == "SHA256SUMS"), None)
    sig = next((a for a in assets if a["name"] == "SHA256SUMS.sig"), None)
    if not sums:
        raise Failure("the newest release has no SHA256SUMS")
    if not os.path.isfile(SIGNERS):
        raise Failure("this ASKus OS has no release key built in, so it can't check updates - "
                      "flash the newest ISO with balenaEtcher instead")
    if not sig:
        raise Failure("the newest release is NOT signed with the ASKus release key - it will not be installed")
    text = curl([sums["url"]])
    # A private temporary file: `check` runs as the desktop user, who can't write to /run/askus.
    with tempfile.TemporaryDirectory(prefix="askus-update-") as tmp:
        sig_path = os.path.join(tmp, "SHA256SUMS.sig")
        with open(sig_path, "w") as f:
            f.write(curl([sig["url"]]))
        r = subprocess.run(["ssh-keygen", "-Y", "verify", "-f", SIGNERS, "-I", SIG_NAMESPACE,
                            "-n", SIG_NAMESPACE, "-s", sig_path],
                           input=text, capture_output=True, text=True)
    if r.returncode != 0:
        raise Failure("the newest release has an INVALID signature - it will not be installed. "
                      "Someone may have tampered with it.")
    return text


SIGNED_ISO = re.compile(r"askus-os-(\d{12})\.iso")
SHA256_HEX = re.compile(r"[0-9a-f]{64}")


def signed_image(assets, tag, current_tag):
    """Check the newest release against its SIGNED SHA256SUMS.
    Returns (iso_name, pieces, sha256). The build number is read from the image name in the
    signed file, not from the release tag: anyone who can publish a GitHub release controls
    the tag, and could otherwise re-publish an old (genuinely signed, but vulnerable) image
    as the "newest" one."""
    iso_name, pieces, _ = image_assets(assets)
    if not pieces:
        raise Failure("the newest release has no system image")
    listed = {}
    for line in verified_sums(assets).splitlines():
        f = line.split()
        if len(f) == 2 and SHA256_HEX.fullmatch(f[0].lower()):
            listed[f[1].lstrip("*")] = f[0].lower()
    images = [n for n in listed if SIGNED_ISO.fullmatch(n)]
    if images != [iso_name]:
        raise Failure("the newest release doesn't match its signed file list - it will not be installed")
    build_id = int(SIGNED_ISO.fullmatch(iso_name).group(1))
    if build_id != build_id_of(tag):
        raise Failure("the newest release's version doesn't match its signed image - it will not be installed")
    if build_id <= build_id_of(current_tag):
        raise Failure("the newest release is not newer than the version you run - it will not be installed")
    return iso_name, pieces, listed[iso_name]


TOR_ISOLATED = "127.0.0.1:9150"      # SocksPort with IsolateSOCKSAuth: each username = its own circuit
CHUNK_DL = 32 * 1024 * 1024           # download unit (a slow circuit only delays its own chunk)
STATE_NAME = ".chunks.json"
VERIFIED_NAME = ".verified"


def download(pieces, dest, total, workers=8, label="Downloading through Tor", ranges=None, already=0):
    """Download the image pieces over several Tor circuits at once.

    Each piece is split into 32 MB chunks; `workers` threads take chunks from a queue and
    fetch them with HTTP range requests, each over its OWN Tor circuit (separate SOCKS
    username on the isolating SocksPort). Everything still goes through Tor; the server
    only sees several Tor exits downloading parts of the same public file. Finished chunks
    are recorded, so an interrupted download resumes where it stopped.
    """
    import queue
    import random
    state_path = os.path.join(dest, STATE_NAME)
    try:
        with open(state_path) as f:
            state = json.load(f)
    except (OSError, ValueError):
        state = {}
    jobs = queue.Queue()
    wanted = {}                                  # state key -> every chunk id that must end up done
    have = {"bytes": 0}
    lock = threading.Lock()
    if ranges is not None:                        # delta mode: only these byte ranges
        # The caller has just hash-checked the destination and planned only its
        # missing ranges. Old completion metadata must not override that scan.
        done_set = set()
        have["bytes"] = already
        wanted["delta"] = set()
        for p, a, b in ranges:
            out = os.path.join(dest, p["name"])
            rid = f'{p["name"]}:{a}-{b}'
            wanted["delta"].add(rid)
            if rid in done_set:
                have["bytes"] += b - a + 1
            else:
                jobs.put((p, "delta", out, rid, a, b))
        state["delta"] = sorted(done_set)
    for p in (pieces if ranges is None else []):
        out = os.path.join(dest, p["name"])
        key = f'{p["name"]}:{p["size"]}'
        done_set = set(state.get(key, []))
        if not os.path.exists(out) or os.path.getsize(out) != p["size"]:
            with open(out, "ab") as f:            # preallocate (sparse) so chunks can land anywhere
                f.truncate(p["size"])
        n = (p["size"] + CHUNK_DL - 1) // CHUNK_DL
        wanted[key] = set(range(n))
        for i in range(n):
            a = i * CHUNK_DL
            b = min(p["size"], a + CHUNK_DL) - 1
            if i in done_set:
                have["bytes"] += b - a + 1
            else:
                jobs.put((p, key, out, i, a, b))
        state[key] = sorted(done_set)
    errors = []

    def save_state():
        tmp = state_path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(state, f)
        os.replace(tmp, state_path)

    def fetch(p, out, a, b, ident):
        cmd = ["curl", "-sfL", "--proxy", f"socks5h://{ident}:x@{TOR_ISOLATED}",
               "--connect-timeout", "60", "--speed-limit", "20000", "--speed-time", "60",
               "-r", f"{a}-{b}", "-H", "User-Agent: askus-update",
               "-w", "%{stderr}%{http_code}", p["url"]]
        pos = a
        fd = os.open(out, os.O_WRONLY)
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        try:
            while True:
                buf = proc.stdout.read(1024 * 1024)
                if not buf:
                    break
                over = pos + len(buf) > b + 1
                if over:
                    buf = buf[: b + 1 - pos]
                os.pwrite(fd, buf, pos)
                pos += len(buf)
                with lock:
                    have["bytes"] += len(buf)
                if over:            # more than asked for: the server ignored the range
                    proc.kill()
                    break
        finally:
            os.close(fd)
            proc.stdout.close()
            rc = proc.wait()
            code = proc.stderr.read().decode(errors="replace").strip()[-3:]
            proc.stderr.close()
        got = pos - a
        # 206 = the server sent exactly the part we asked for (a server that ignores the
        # range would send the file from the start - never accept that)
        partial_ok = code == "206" or (a == 0 and b + 1 == p["size"] and code == "200")
        if rc != 0 or got != b - a + 1 or not partial_ok:
            with lock:
                have["bytes"] -= got
            return False
        return True

    def worker(w):
        try:
            while True:
                try:
                    p, key, out, i, a, b = jobs.get_nowait()
                except queue.Empty:
                    return
                for attempt in range(8):
                    ident = f"askus-update-{w}-{attempt}-{random.getrandbits(48):x}"   # fresh circuit per try
                    if fetch(p, out, a, b, ident):
                        with lock:
                            state[key] = sorted(set(state[key]) | {i})
                            save_state()
                        break
                    time.sleep(3 + attempt * 2)
                else:
                    errors.append(p["name"])
                    return
        except Exception as e:  # noqa: BLE001 - e.g. disk full: a dead worker must not look like success
            errors.append(f"{e.__class__.__name__}: {e}")

    stop = threading.Event()

    def watch():
        last, t0 = have["bytes"], time.time()
        while not stop.wait(1):
            cur = have["bytes"]
            rate = (cur - last) / max(time.time() - t0, 1e-3)
            if time.time() - t0 > 5:
                last, t0 = cur, time.time()
            write_status(state="running",
                         step=f"{label} ({cur/1e9:.2f} of {total/1e9:.2f} GB, {rate/1e6:.1f} MB/s)",
                         progress=round(5 + 55 * cur / max(total, 1), 1))
    t = threading.Thread(target=watch, daemon=True)
    t.start()
    threads = [threading.Thread(target=worker, args=(w,), daemon=True) for w in range(max(1, workers))]
    try:
        for th in threads:
            th.start()
        for th in threads:
            th.join()
    finally:
        stop.set()
        t.join()
    incomplete = any(not ids <= set(state.get(k, [])) for k, ids in wanted.items())
    if errors or not jobs.empty() or incomplete:
        raise Failure("the download kept failing - check your connection and try again (it will resume)")


# ---------------------------------------------------------------- fast (delta) updates
INDEX_SUFFIX = ".index.gz"
INDEX_TAG = "image-indices"            # permanent release that keeps every build's index
SAVED_INDEX_DIR = PERSIST_MNT + "/.askus-index"
MERGE_GAP = 512 * 1024                 # fetch small unchanged gaps too: fewer, bigger requests
MAX_INDEX_CHUNK = 4 * 1024 * 1024      # MAX_SIZE in tools/askus-cdc.c


def curl_bytes(url, timeout=300):
    cmd = ["curl", "-fsSL", "--proxy", TOR, "--retry", "3", "--max-time", str(timeout),
           "-H", "User-Agent: askus-update", url]
    return subprocess.run(cmd, capture_output=True, check=True).stdout


def parse_index(raw):
    """-> (image size, [(offset, length, sha256)]) or raises ValueError."""
    import gzip
    lines = gzip.decompress(raw).decode().split("\n")
    head = lines[0].split()
    if len(head) != 4 or head[:2] != ["askus-delta-index", "1"]:
        raise ValueError("not an ASKus delta index")
    chunks, pos = [], 0
    for line in lines[1:]:
        if not line:
            continue
        o, n, h = line.split()
        o, n = int(o), int(n)
        if o != pos or not 0 < n <= MAX_INDEX_CHUNK or not SHA256_HEX.fullmatch(h.lower()):
            raise ValueError("broken delta index")
        chunks.append((o, n, h.lower()))
        pos += n
    if pos != int(head[3]):
        raise ValueError("delta index size mismatch")
    return pos, chunks


def index_name_for(tag):
    m = re.search(r"(\d{12})", tag or "")
    return f"askus-os-{m.group(1)}.iso{INDEX_SUFFIX}" if m else None


def old_index(cur):
    """Index of the version on this stick: saved copy, else the permanent index release,
    else that version's own release. It does not need to be trusted: every chunk taken
    from the stick is checked against the NEW (and finally the signed) fingerprints."""
    name = index_name_for(cur.get("TAG"))
    if not name:
        return None
    local = os.path.join(SAVED_INDEX_DIR, name)
    if os.path.isfile(local):
        try:
            return parse_index(open(local, "rb").read())
        except (OSError, ValueError):
            pass
    repo = cur["UPDATE_REPO"]
    for url in (f"https://github.com/{repo}/releases/download/{INDEX_TAG}/{name}",
                f"https://github.com/{repo}/releases/download/{cur['TAG']}/{name}"):
        try:
            return parse_index(curl_bytes(url, timeout=180))
        except (subprocess.CalledProcessError, ValueError, OSError):
            continue
    return None


def save_index(raw, tag):
    """Remember the index of the version just installed (for the next fast update)."""
    name = index_name_for(tag)
    if not raw or not name or not os.path.ismount(PERSIST_MNT):
        return
    try:
        os.makedirs(SAVED_INDEX_DIR, mode=0o700, exist_ok=True)
        for f in os.listdir(SAVED_INDEX_DIR):
            if f.endswith(INDEX_SUFFIX) and f != name:
                os.remove(os.path.join(SAVED_INDEX_DIR, f))
        with open(os.path.join(SAVED_INDEX_DIR, name), "wb") as f:
            f.write(raw)
    except OSError:
        pass


def delta_prepare(pieces, dest, new_chunks, old_chunks, disk):
    """Keep verified downloaded chunks, then copy unchanged chunks from the stick.
    Returns ([(offset, end) ranges still needed], bytes re-used locally).
    A partial HTTP request can contain complete indexed chunks: recover those
    without trusting download metadata, including when no old stick index exists.
    """
    where = {}
    for o, n, h in old_chunks:
        where.setdefault(h, (o, n))
    starts, cached_sizes, pos = [], [], 0
    for p in pieces:
        out = os.path.join(dest, p["name"])
        cached_sizes.append(os.path.getsize(out) if os.path.exists(out) else 0)
        if not os.path.exists(out) or os.path.getsize(out) != p["size"]:
            with open(out, "ab") as f:
                f.truncate(p["size"])
        starts.append(pos)
        pos += p["size"]
    fds = [os.open(os.path.join(dest, p["name"]), os.O_RDWR) for p in pieces]

    def cached(off, n, expected):
        h = hashlib.sha256()
        while n:
            i = max(k for k in range(len(pieces)) if starts[k] <= off)
            rel = off - starts[i]
            size = min(n, pieces[i]["size"] - rel)
            if size <= 0 or rel + size > cached_sizes[i]:
                return False
            data = os.pread(fds[i], size, rel)
            if len(data) != size:
                return False
            h.update(data)
            off += size
            n -= size
        return h.hexdigest() == expected

    def put(off, data):
        while data:
            i = max(k for k in range(len(pieces)) if starts[k] <= off)
            rel = off - starts[i]
            part = data[: pieces[i]["size"] - rel]
            os.pwrite(fds[i], part, rel)
            off += len(part)
            data = data[len(part):]

    need, reused = [], 0
    src = None
    try:
        if disk:
            src = os.open(disk, os.O_RDONLY)
        for k, (o, n, h) in enumerate(new_chunks):
            hit = where.get(h)
            ok = cached(o, n, h)
            if ok:
                reused += n
            elif src is not None and hit and hit[1] == n:
                data = os.pread(src, n, hit[0])
                if len(data) == n and hashlib.sha256(data).hexdigest() == h:
                    put(o, data)
                    reused += n
                    ok = True
            if not ok:
                need.append((o, o + n - 1))
            if k % 200 == 0:
                write_status(state="running",
                             step=f"Re-using verified parts already downloaded or on your USB stick "
                                  f"({k * 100 // max(len(new_chunks), 1)}%)…",
                             progress=round(3 + 2 * k / max(len(new_chunks), 1), 1))
    finally:
        if src is not None:
            os.close(src)
        for fd in fds:
            os.fsync(fd)
            os.close(fd)
    return need, reused


def ranges_for_pieces(need, pieces):
    """Merge nearby ranges, cut them to <= 32 MB and map them onto the image pieces."""
    merged = []
    for a, b in sorted(need):
        if merged and a - merged[-1][1] - 1 <= MERGE_GAP and b - merged[-1][0] + 1 <= CHUNK_DL:
            merged[-1][1] = max(merged[-1][1], b)
        else:
            merged.append([a, b])
    out, starts, pos = [], [], 0
    for p in pieces:
        starts.append(pos)
        pos += p["size"]
    for a, b in merged:
        while a <= b:
            i = max(k for k in range(len(pieces)) if starts[k] <= a)
            end = min(b, starts[i] + pieces[i]["size"] - 1, a + CHUNK_DL - 1)
            out.append((pieces[i], a - starts[i], end - starts[i]))
            a = end + 1
    return out


def fetch_image(cur, assets, pieces, dest, total, expected, workers, label, check_label):
    """Get the new image into `dest` - fast (only the changes) when possible, otherwise in
    full - and verify it against the signed SHA256SUMS. Returns (ok, new index bytes)."""
    paths = [os.path.join(dest, p["name"]) for p in pieces]
    mark = os.path.join(dest, VERIFIED_NAME)
    new_raw, plan = None, None
    idx = next((a for a in assets if a["name"].endswith(INDEX_SUFFIX)), None)
    try:
        if idx:
            new_raw = curl_bytes(idx["url"], timeout=180)
    except Exception:  # noqa: BLE001
        new_raw = None

    def finish(ok):
        if ok:
            with open(mark, "w") as f:
                f.write(expected)
        return ok, new_raw

    # Already downloaded and verified in the background? Re-check it and use it.
    try:
        if open(mark).read().strip() == expected and \
                all(os.path.getsize(x) == p["size"] for x, p in zip(paths, pieces)):
            if sha256_of_pieces(paths, total, check_label, 60, 6) == expected:
                return finish(True)
    except OSError:
        pass
    try:
        if new_raw:
            write_status(state="running", step="Checking what changed in the new version…", progress=2)
            ntotal, nchunks = parse_index(new_raw)
            if ntotal != total:
                raise ValueError("delta index does not match image pieces")
            disk = boot_disk()
            old = old_index(cur) if disk else None
            need, reused = delta_prepare(pieces, dest, nchunks, old[1] if old else [], disk if old else None)
            plan = (ranges_for_pieces(need, pieces), reused)
    except Exception:  # noqa: BLE001 - any problem: just download everything
        plan = None
    if plan:
        ranges, reused = plan
        size = sum(b - a + 1 for _, a, b in ranges)
        download(pieces, dest, total, workers=workers, ranges=ranges, already=total - size,
                 label=f"{label} - only the changes, {size/1e6:.0f} MB")
        if sha256_of_pieces(paths, total, check_label, 60, 6) == expected:
            return finish(True)
        try:                                   # should not happen: fall back to a full download
            os.remove(os.path.join(dest, STATE_NAME))
        except OSError:
            pass
    download(pieces, dest, total, workers=workers, label=label)
    return finish(sha256_of_pieces(paths, total, check_label, 60, 6) == expected)


def sha256_of_pieces(paths, total, step, base, span):
    h = hashlib.sha256()
    seen = 0
    for path in paths:
        with open(path, "rb") as f:
            while True:
                b = f.read(CHUNK)
                if not b:
                    break
                h.update(b)
                seen += len(b)
                if seen % (64 * CHUNK) < CHUNK:
                    write_status(state="running", step=step, progress=round(base + span * seen / total, 1))
    return h.hexdigest()


def move_system_into_ram():
    """Copy the running squashfs into RAM and switch the loop device to the copy."""
    if not os.path.ismount(MEDIUM):
        return  # already running from RAM ("toram")
    size = os.path.getsize(SQUASHFS)
    if mem_available() < size + 600 * 1024 * 1024:
        raise Failure(f"not enough free memory to update while running from the USB stick "
                      f"(needs about {(size + 600e6)/1e9:.1f} GB free). Restart, press E at the boot menu, "
                      f"add the word toram to the linux line, boot, and run the update again.")
    loops = re.findall(r"^(/dev/loop\d+):", sh("losetup", "-j", SQUASHFS).stdout, re.M)
    if not loops:
        raise Failure("could not find the system image loop device")
    os.makedirs(SQUASH_RAM, exist_ok=True)
    if not os.path.ismount(SQUASH_RAM):
        sh("mount", "-t", "tmpfs", "-o", f"size={size + 64*1024*1024},mode=0700", "tmpfs", SQUASH_RAM, check=True)
    copy = os.path.join(SQUASH_RAM, "filesystem.squashfs")
    write_status(state="running", step="Moving the running system into memory…", progress=68)
    shutil.copyfile(SQUASHFS, copy)
    nf = os.open(copy, os.O_RDONLY)
    for loop in loops:
        fd = os.open(loop, os.O_RDONLY)
        try:
            fcntl.ioctl(fd, LOOP_CHANGE_FD, nf)
        except OSError as e:
            raise Failure(f"could not move the system into memory ({e.strerror}). Restart with toram "
                          f"(press E at the boot menu and add toram) and try again.") from e
        finally:
            os.close(fd)
    os.close(nf)
    sh("umount", "-l", MEDIUM)


def cmd_apply():
    if os.geteuid() != 0:
        sys.exit("must run as root")
    try:
        cur = release_info()
        write_status(state="running", step="Looking for the newest version…", progress=1)
        tag, published, assets = latest_release(cur["UPDATE_REPO"])
        if build_id_of(tag) <= build_id_of(cur["TAG"]):
            write_status(state="done", step="ASKus OS is already up to date", progress=100, reboot=False)
            return 0
        _, pieces, expected = signed_image(assets, tag, cur["TAG"])
        total = sum(p["size"] for p in pieces)

        disk = boot_disk()
        if not disk:
            raise Failure("updating needs ASKus OS to be started from its USB stick")
        persist = persistence_partition(disk)
        if persist and total > persist[1] * 512:
            raise Failure("the new version is larger than the space reserved before your Persistent "
                          "Storage. Back up your Persistent folder and flash the new ISO with balenaEtcher.")

        # where to download
        if os.path.ismount(PERSIST_MNT) and shutil.disk_usage(PERSIST_MNT).free > total + 200e6:
            dest = os.path.join(PERSIST_MNT, ".askus-update")
            os.makedirs(dest, exist_ok=True)
        else:
            need = total + 64 * 1024 * 1024
            squash = os.path.getsize(SQUASHFS) if os.path.ismount(MEDIUM) else 0
            if mem_available() < need + squash + 700 * 1024 * 1024:
                raise Failure(f"not enough free memory to download the update "
                              f"(needs about {(need + squash + 700e6)/1e9:.1f} GB). Unlock your Persistent "
                              f"Storage at startup so the download can be stored there, or use a computer with more RAM.")
            dest = RAM_DIR
            os.makedirs(dest, exist_ok=True)
            if not os.path.ismount(dest):
                sh("mount", "-t", "tmpfs", "-o", f"size={need},mode=0700", "tmpfs", dest, check=True)
        # remove leftovers of older downloads
        for f in os.listdir(dest):
            if f not in {p["name"] for p in pieces} | {STATE_NAME, VERIFIED_NAME}:
                os.remove(os.path.join(dest, f))
        if dest == RAM_DIR:   # may be left over from an earlier attempt sized for another release
            sh("mount", "-o", f"remount,size={need}", dest, check=True)

        paths = [os.path.join(dest, p["name"]) for p in pieces]
        ok, new_index = fetch_image(cur, assets, pieces, dest, total, expected, 8,
                                    "Downloading through Tor", "Checking the download (SHA-256)…")
        if not ok:
            for p in paths + [os.path.join(dest, STATE_NAME), os.path.join(dest, VERIFIED_NAME)]:
                if os.path.exists(p):
                    os.remove(p)
            raise Failure("the download is damaged (checksum mismatch) and was deleted — try again")

        move_system_into_ram()

        # write the new image to the start of the stick
        write_status(state="running", step="Writing the new version to the USB stick — do not unplug it", progress=70)
        written = 0
        fd = os.open(disk, os.O_WRONLY)
        try:
            for path in paths:
                with open(path, "rb") as f:
                    while written < total:          # never more than the verified size
                        b = f.read(min(CHUNK, total - written))
                        if not b:
                            break
                        view = memoryview(b)
                        while view:
                            n = os.write(fd, view)
                            if n <= 0:
                                raise Failure("could not write to the USB stick. Do not restart; try the "
                                              "update again, or flash the ISO with balenaEtcher")
                            view = view[n:]
                        written += len(b)
                        if written % (16 * CHUNK) < CHUNK:
                            os.fsync(fd)
                            write_status(state="running",
                                         step="Writing the new version to the USB stick — do not unplug it",
                                         progress=round(70 + 20 * written / total, 1))
            os.fsync(fd)
        finally:
            os.close(fd)
        if written != total:
            raise Failure("the downloaded image changed before it was written. Do not restart; "
                          "try the update again, or flash the ISO with balenaEtcher")

        # put the Persistent Storage entry back into the new partition table
        if persist:
            _, start, size = persist
            r = subprocess.run(["sfdisk", "--append", "--force", "--no-reread", "--no-tell-kernel", disk],
                               input=f"{start},{size},L\n", capture_output=True, text=True)
            if r.returncode != 0:
                raise Failure("the new version was written but the Persistent Storage entry could not be "
                              f"restored: {r.stderr.strip()}")

        # Read back and verify the system area. The partition table (first 34 sectors)
        # legitimately changes when the Persistent Storage entry is restored, so those
        # bytes are taken from the downloaded image and the boot code is compared separately.
        sh("sync")
        HEAD = 34 * 512
        with open(paths[0], "rb") as f:
            img_head = f.read(HEAD)
        h = hashlib.sha256()
        left = total
        first = True
        with open(disk, "rb", buffering=0) as f:
            # drop the cached copy of what was just written, so this really reads the stick
            try:
                fcntl.ioctl(f.fileno(), BLKFLSBUF)
            except OSError:
                os.posix_fadvise(f.fileno(), 0, 0, os.POSIX_FADV_DONTNEED)
            while left > 0:
                b = f.read(min(CHUNK, left))
                if not b:
                    break
                if first:
                    if b[:446] != img_head[:446]:
                        raise Failure("verification of the USB stick failed (boot sector). Do not restart; "
                                      "try the update again, or flash the ISO with balenaEtcher")
                    b = img_head + b[HEAD:]
                    first = False
                h.update(b)
                left -= len(b)
                if (total - left) % (64 * CHUNK) < CHUNK:
                    write_status(state="running", step="Verifying the USB stick…",
                                 progress=round(90 + 9 * (total - left) / total, 1))
        if h.hexdigest() != expected:
            raise Failure("verification of the USB stick failed. Do not restart; try the update again, "
                          "or flash the ISO with balenaEtcher")

        for p in paths:
            os.remove(p)
        save_index(new_index, tag)
        write_status(state="done", step=f"ASKus OS {tag} is installed. Restart to use it.", progress=100,
                     reboot=True, tag=tag)
        return 0
    except Failure as e:
        write_status(state="error", error=str(e), progress=0)
        return 1
    except Exception as e:  # noqa: BLE001
        write_status(state="error", error=f"unexpected error: {e}", progress=0)
        return 1


PREFETCH_STATUS = "/run/askus/prefetch.json"


def notify_user(title, body, action_label=None):
    """Desktop notification for the logged-in user; optional button that opens ASKus Update."""
    try:
        import pwd
        uid = pwd.getpwnam("askus").pw_uid
    except KeyError:
        return
    bus = f"/run/user/{uid}/bus"
    if not os.path.exists(bus):
        return
    ns = ["notify-send", "--app-name=ASKus Update", "--icon=askus-logo", title, body]
    if action_label:
        ns[1:1] = [f"--action=update={action_label}", "--action=later=Later"]
        script = 'a=$("$@"); [ "$a" = update ] && exec /usr/local/bin/askus-updater'
        cmd = ["runuser", "-u", "askus", "--", "env", f"DBUS_SESSION_BUS_ADDRESS=unix:path={bus}",
               f"XDG_RUNTIME_DIR=/run/user/{uid}", "sh", "-c", script, "sh"] + ns
    else:
        cmd = ["runuser", "-u", "askus", "--", "env", f"DBUS_SESSION_BUS_ADDRESS=unix:path={bus}"] + ns
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def cmd_prefetch():
    """Download a newer, correctly signed release into Persistent Storage in the background,
    so that "Update now" only has to write it to the stick. Runs from askus-update-prefetch.timer.
    Only when Persistent Storage is unlocked (never fills RAM), through Tor, gently (4 circuits)."""
    global STATUS
    if os.geteuid() != 0:
        sys.exit("must run as root")
    STATUS = PREFETCH_STATUS
    if not os.path.ismount(PERSIST_MNT):
        write_status(state="idle", step="Persistent Storage is locked - no background download")
        return 0
    if sh("systemctl", "is-active", "--quiet", "askus-update.service").returncode == 0:
        return 0
    try:
        cur = release_info()
        tag, published, assets = latest_release(cur["UPDATE_REPO"])
        if build_id_of(tag) <= build_id_of(cur["TAG"]):
            write_status(state="idle", step="up to date")
            return 0
        _, pieces, expected = signed_image(assets, tag, cur["TAG"])   # refuses unsigned / tampered / older
        total = sum(p["size"] for p in pieces)
        if shutil.disk_usage(PERSIST_MNT).free < total + 500e6:
            write_status(state="idle", step="not enough space in Persistent Storage for a background download")
            return 0
        dest = os.path.join(PERSIST_MNT, ".askus-update")
        os.makedirs(dest, exist_ok=True)
        for f in os.listdir(dest):
            if f not in {p["name"] for p in pieces} | {STATE_NAME, VERIFIED_NAME}:
                os.remove(os.path.join(dest, f))
        paths = [os.path.join(dest, p["name"]) for p in pieces]
        ok, _ = fetch_image(cur, assets, pieces, dest, total, expected, 4,
                            "Downloading the update in the background", "Checking the download…")
        if not ok:
            for p in paths + [os.path.join(dest, STATE_NAME), os.path.join(dest, VERIFIED_NAME)]:
                if os.path.exists(p):
                    os.remove(p)
            write_status(state="error", error="background download was damaged and deleted; it will retry")
            return 1
        write_status(state="ready", step=f"{tag} downloaded and verified", latest=tag)
        notify_user("ASKus OS update ready",
                    f"{tag} has been downloaded and verified in the background. Installing it now only "
                    "takes a few minutes.", "Install now")
        return 0
    except Failure as e:
        write_status(state="error", error=str(e))
        return 1
    except Exception as e:  # noqa: BLE001
        write_status(state="error", error=f"{e.__class__.__name__}: {e}")
        return 1


def main():
    a = sys.argv[1:] or ["check"]
    if a[0] == "check":
        return cmd_check("--json" in a)
    if a[0] == "status":
        return cmd_status()
    if a[0] == "start":
        return cmd_start()
    if a[0] == "apply":
        return cmd_apply()
    if a[0] == "prefetch":
        return cmd_prefetch()
    sys.exit("usage: askus-update check [--json] | status | start | prefetch")


if __name__ == "__main__":
    sys.exit(main())

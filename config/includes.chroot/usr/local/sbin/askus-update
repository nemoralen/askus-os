#!/usr/bin/python3
"""ASKus OS updater.

  askus-update check [--json]   is a newer signed build available? (any user)
  askus-update status           progress of a running update (any user)
  askus-update start            start updating in the background (root, via pkexec)
  askus-update apply            the update itself (run by `start` as a systemd unit)
  askus-update prefetch         download a newer signed release in the background (timer)

How an update works:
  1. The newest GitHub Release of UPDATE_REPO (see /etc/askus-release) is fetched
     through Tor, and the image (one .iso or .iso.partNN pieces) is downloaded into
     Persistent Storage if it's unlocked, otherwise into RAM.
  2. Its SHA-256 is checked against the release's SHA256SUMS.
  3. The running system is moved off the USB stick: its squashfs is copied into RAM
     and the loop device is switched over to the copy (LOOP_CHANGE_FD).
  4. The new image is written to the start of the stick, read back and verified, and
     the Persistent Storage partition entry (which starts at 4 GiB, behind the
     image area) is restored, so saved data is kept.
  5. Restart to boot the new version.
"""
import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time
import urllib.request

RELEASE_FILE = "/etc/askus-release"
STATUS = "/run/askus/update.json"
MEDIUM = "/run/live/medium"
SQUASHFS = MEDIUM + "/live/filesystem.squashfs"
PERSIST_LABEL = "ASKusPersistence"
PERSIST_MNT = "/run/askus/persistence"
RAM_DIR = "/run/askus/update-ram"
SQUASH_RAM = "/run/askus/rootfs-ram"
TOR = "socks5h://127.0.0.1:9050"
LOOP_CHANGE_FD = 0x4C06
CHUNK = 4 * 1024 * 1024


# ---------------------------------------------------------------- helpers
def release_info():
    info = {"VERSION": "1.0", "BUILD_ID": "0", "TAG": "dev", "UPDATE_REPO": "nemoralen/askus-os"}
    try:
        for line in open(RELEASE_FILE):
            if "=" in line:
                k, v = line.strip().split("=", 1)
                info[k] = v
    except OSError:
        pass
    return info


def build_id_of(tag):
    m = re.search(r"(\d{12})", tag or "")
    return int(m.group(1)) if m else 0


def curl(args, timeout=60):
    cmd = ["curl", "-fsSL", "--proxy", TOR, "--retry", "3", "--max-time", str(timeout),
           "-H", "User-Agent: askus-update"] + args
    return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout


def latest_release(repo):
    data = json.loads(curl([f"https://api.github.com/repos/{repo}/releases/latest"]))
    assets = [{"name": a["name"], "url": a["browser_download_url"], "size": a["size"]}
              for a in data.get("assets", [])]
    return data["tag_name"], data.get("published_at", ""), assets


def image_assets(assets):
    """Return (iso_name, [pieces in order], SHA256SUMS asset)."""
    sums = next((a for a in assets if a["name"] == "SHA256SUMS"), None)
    whole = [a for a in assets if a["name"].endswith(".iso")]
    parts = sorted([a for a in assets if re.search(r"\.iso\.part\d+$", a["name"])],
                   key=lambda a: a["name"])
    if whole:
        return whole[0]["name"], whole[:1], sums
    if parts:
        return re.sub(r"\.part\d+$", "", parts[0]["name"]), parts, sums
    return None, [], sums


def write_status(**kw):
    kw["time"] = int(time.time())
    os.makedirs(os.path.dirname(STATUS), exist_ok=True)
    tmp = STATUS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(kw, f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, STATUS)


def sh(*cmd, **kw):
    return subprocess.run(list(cmd), capture_output=True, text=True, **kw)


def boot_disk():
    src = sh("findmnt", "-no", "SOURCE", MEDIUM).stdout.strip()
    if not src:  # started with "toram": find the stick by its volume label
        devs = sh("blkid", "-t", "LABEL=ASKUS_OS", "-o", "device").stdout.split()
        devs = [d for d in devs if not d.startswith("/dev/sr")]
        src = devs[0] if devs else ""
    if not src or src.startswith(("/dev/sr", "/dev/loop")):
        return None
    pk = sh("lsblk", "-no", "PKNAME", src).stdout.split()
    return "/dev/" + pk[0] if pk else None


def persistence_partition(disk):
    """(device, start_sector, size_sectors) of the LUKS Persistent Storage, or None."""
    out = sh("lsblk", "-lnpo", "NAME,TYPE", disk).stdout.split("\n")
    for line in out:
        f = line.split()
        if len(f) == 2 and f[1] == "part":
            p = f[0]
            if (sh("blkid", "-s", "TYPE", "-o", "value", p).stdout.strip() == "crypto_LUKS" and
                    sh("blkid", "-s", "LABEL", "-o", "value", p).stdout.strip() == PERSIST_LABEL):
                name = os.path.basename(p)
                start = int(open(f"/sys/class/block/{name}/start").read())
                size = int(open(f"/sys/class/block/{name}/size").read())
                return p, start, size
    return None


def mem_available():
    for line in open("/proc/meminfo"):
        if line.startswith("MemAvailable:"):
            return int(line.split()[1]) * 1024
    return 0


# ---------------------------------------------------------------- commands
def cmd_check(as_json):
    cur = release_info()
    try:
        tag, published, assets = latest_release(cur["UPDATE_REPO"])
    except Exception as e:  # noqa: BLE001
        res = {"ok": False, "error": f"could not reach the update server through Tor ({e.__class__.__name__})",
               "current": cur["TAG"]}
        print(json.dumps(res) if as_json else res["error"])
        return 2
    name, pieces, _ = image_assets(assets)
    newer = build_id_of(tag) > build_id_of(cur["TAG"]) and bool(pieces)
    if newer:
        try:
            verified_sums(assets)
        except Exception as e:  # noqa: BLE001
            res = {"ok": False, "current": cur["TAG"], "latest": tag,
                   "error": str(e) if isinstance(e, Failure) else
                   f"could not check the update's signature ({e.__class__.__name__})"}
            print(json.dumps(res) if as_json else res["error"])
            return 3
    res = {"ok": True, "current": cur["TAG"], "latest": tag, "published": published,
           "newer": newer, "size": sum(p["size"] for p in pieces)}
    if as_json:
        print(json.dumps(res))
    else:
        print(f"installed: {cur['TAG']}\nlatest:    {tag} ({published})")
        print("an update is available" if newer else "ASKus OS is up to date")
    return 0


def cmd_status():
    try:
        print(open(STATUS).read())
    except OSError:
        print(json.dumps({"state": "idle"}))
    return 0


def cmd_start():
    if os.geteuid() != 0:
        sys.exit("must run as root (pkexec askus-update start)")
    if sh("systemctl", "is-active", "--quiet", "askus-update.service").returncode == 0:
        print("already running")
        return 0
    write_status(state="running", step="Starting…", progress=0)
    sh("systemctl", "stop", "askus-update-prefetch.service")   # the update continues its download
    sh("systemctl", "reset-failed", "askus-update.service")
    r = sh("systemd-run", "--unit=askus-update", "--collect", "--quiet",
           "--property=Type=exec", "/usr/local/sbin/askus-update", "apply")
    if r.returncode != 0:
        write_status(state="error", error=r.stderr.strip() or "could not start the updater")
        return 1
    print("started")
    return 0


class Failure(Exception):
    pass


SIGNERS = "/etc/askus/release-signers"   # public key(s) allowed to sign releases
SIG_NAMESPACE = "askus-release"


def verified_sums(assets):
    """Download SHA256SUMS and check its signature against the ASKus release key.
    Returns the SHA256SUMS text, or raises Failure. An update that is not signed with
    the key built into this system is never installed."""
    sums = next((a for a in assets if a["name"] == "SHA256SUMS"), None)
    sig = next((a for a in assets if a["name"] == "SHA256SUMS.sig"), None)
    if not sums:
        raise Failure("the newest release has no SHA256SUMS")
    text = curl([sums["url"]])
    if not os.path.isfile(SIGNERS):          # developer build without a release key
        return text
    if not sig:
        raise Failure("the newest release is NOT signed with the ASKus release key - it will not be installed")
    sig_path = "/run/askus/SHA256SUMS.sig"
    os.makedirs("/run/askus", exist_ok=True)
    with open(sig_path, "w") as f:
        f.write(curl([sig["url"]]))
    r = subprocess.run(["ssh-keygen", "-Y", "verify", "-f", SIGNERS, "-I", SIG_NAMESPACE,
                        "-n", SIG_NAMESPACE, "-s", sig_path],
                       input=text, capture_output=True, text=True)
    if r.returncode != 0:
        raise Failure("the newest release has an INVALID signature - it will not be installed. "
                      "Someone may have tampered with it.")
    return text


TOR_ISOLATED = "127.0.0.1:9150"      # SocksPort with IsolateSOCKSAuth: each username = its own circuit
CHUNK_DL = 32 * 1024 * 1024           # download unit (a slow circuit only delays its own chunk)
STATE_NAME = ".chunks.json"


def download(pieces, dest, total, workers=6, label="Downloading through Tor"):
    """Download the image pieces over several Tor circuits at once.

    Each piece is split into 32 MB chunks; `workers` threads take chunks from a queue and
    fetch them with HTTP range requests, each over its OWN Tor circuit (separate SOCKS
    username on the isolating SocksPort). Everything still goes through Tor; the server
    only sees several Tor exits downloading parts of the same public file. Finished chunks
    are recorded, so an interrupted download resumes where it stopped.
    """
    import queue
    import random
    state_path = os.path.join(dest, STATE_NAME)
    try:
        state = json.load(open(state_path))
    except (OSError, ValueError):
        state = {}
    jobs = queue.Queue()
    have = {"bytes": 0}
    lock = threading.Lock()
    for p in pieces:
        out = os.path.join(dest, p["name"])
        key = f'{p["name"]}:{p["size"]}'
        done_set = set(state.get(key, []))
        if not os.path.exists(out) or os.path.getsize(out) != p["size"]:
            with open(out, "ab") as f:            # preallocate (sparse) so chunks can land anywhere
                f.truncate(p["size"])
        n = (p["size"] + CHUNK_DL - 1) // CHUNK_DL
        for i in range(n):
            a = i * CHUNK_DL
            b = min(p["size"], a + CHUNK_DL) - 1
            if i in done_set:
                have["bytes"] += b - a + 1
            else:
                jobs.put((p, key, out, i, a, b))
        state[key] = sorted(done_set)
    errors = []

    def save_state():
        tmp = state_path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(state, f)
        os.replace(tmp, state_path)

    def fetch(p, out, a, b, ident):
        cmd = ["curl", "-sfL", "--proxy", f"socks5h://{ident}:x@{TOR_ISOLATED}",
               "--connect-timeout", "60", "--speed-limit", "20000", "--speed-time", "60",
               "-r", f"{a}-{b}", "-H", "User-Agent: askus-update", p["url"]]
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE)
        pos = a
        fd = os.open(out, os.O_WRONLY)
        try:
            while True:
                buf = proc.stdout.read(1024 * 1024)
                if not buf:
                    break
                if pos + len(buf) > b + 1:
                    buf = buf[: b + 1 - pos]
                os.pwrite(fd, buf, pos)
                pos += len(buf)
                with lock:
                    have["bytes"] += len(buf)
        finally:
            os.close(fd)
            proc.stdout.close()
            rc = proc.wait()
        got = pos - a
        if rc != 0 or got != b - a + 1:
            with lock:
                have["bytes"] -= got
            return False
        return True

    def worker(w):
        while True:
            try:
                p, key, out, i, a, b = jobs.get_nowait()
            except queue.Empty:
                return
            for attempt in range(8):
                ident = f"askus-update-{w}-{attempt}-{random.getrandbits(48):x}"   # fresh circuit per try
                if fetch(p, out, a, b, ident):
                    with lock:
                        state[key] = sorted(set(state[key]) | {i})
                        save_state()
                    break
                time.sleep(3 + attempt * 2)
            else:
                errors.append(p["name"])
                return

    stop = threading.Event()

    def watch():
        last, t0 = have["bytes"], time.time()
        while not stop.wait(1):
            cur = have["bytes"]
            rate = (cur - last) / max(time.time() - t0, 1e-3)
            if time.time() - t0 > 5:
                last, t0 = cur, time.time()
            write_status(state="running",
                         step=f"{label} ({cur/1e9:.2f} of {total/1e9:.2f} GB, {rate/1e6:.1f} MB/s)",
                         progress=round(5 + 55 * cur / max(total, 1), 1))
    t = threading.Thread(target=watch, daemon=True)
    t.start()
    threads = [threading.Thread(target=worker, args=(w,), daemon=True) for w in range(max(1, workers))]
    try:
        for th in threads:
            th.start()
        for th in threads:
            th.join()
    finally:
        stop.set()
        t.join()
    if errors or not jobs.empty():
        raise Failure("the download kept failing - check your connection and try again (it will resume)")


def sha256_of_pieces(paths, total, step, base, span):
    h = hashlib.sha256()
    seen = 0
    for path in paths:
        with open(path, "rb") as f:
            while True:
                b = f.read(CHUNK)
                if not b:
                    break
                h.update(b)
                seen += len(b)
                if seen % (64 * CHUNK) < CHUNK:
                    write_status(state="running", step=step, progress=round(base + span * seen / total, 1))
    return h.hexdigest()


def move_system_into_ram():
    """Copy the running squashfs into RAM and switch the loop device to the copy."""
    if not os.path.ismount(MEDIUM):
        return  # already running from RAM ("toram")
    size = os.path.getsize(SQUASHFS)
    if mem_available() < size + 600 * 1024 * 1024:
        raise Failure(f"not enough free memory to update while running from the USB stick "
                      f"(needs about {(size + 600e6)/1e9:.1f} GB free). Restart, press E at the boot menu, "
                      f"add the word toram to the linux line, boot, and run the update again.")
    loops = re.findall(r"^(/dev/loop\d+):", sh("losetup", "-j", SQUASHFS).stdout, re.M)
    if not loops:
        raise Failure("could not find the system image loop device")
    os.makedirs(SQUASH_RAM, exist_ok=True)
    if not os.path.ismount(SQUASH_RAM):
        sh("mount", "-t", "tmpfs", "-o", f"size={size + 64*1024*1024},mode=0700", "tmpfs", SQUASH_RAM, check=True)
    copy = os.path.join(SQUASH_RAM, "filesystem.squashfs")
    write_status(state="running", step="Moving the running system into memory…", progress=68)
    shutil.copyfile(SQUASHFS, copy)
    nf = os.open(copy, os.O_RDONLY)
    for loop in loops:
        fd = os.open(loop, os.O_RDONLY)
        try:
            fcntl.ioctl(fd, LOOP_CHANGE_FD, nf)
        except OSError as e:
            raise Failure(f"could not move the system into memory ({e.strerror}). Restart with toram "
                          f"(press E at the boot menu and add toram) and try again.") from e
        finally:
            os.close(fd)
    os.close(nf)
    sh("umount", "-l", MEDIUM)


def cmd_apply():
    if os.geteuid() != 0:
        sys.exit("must run as root")
    try:
        cur = release_info()
        write_status(state="running", step="Looking for the newest version…", progress=1)
        tag, published, assets = latest_release(cur["UPDATE_REPO"])
        if build_id_of(tag) <= build_id_of(cur["TAG"]):
            write_status(state="done", step="ASKus OS is already up to date", progress=100, reboot=False)
            return 0
        iso_name, pieces, sums = image_assets(assets)
        if not pieces or not sums:
            raise Failure("the newest release has no system image or no SHA256SUMS")
        expected = None
        for line in verified_sums(assets).splitlines():
            f = line.split()
            if len(f) == 2 and f[1].lstrip("*") == iso_name:
                expected = f[0].lower()
        if not expected:
            raise Failure("SHA256SUMS does not list the system image")
        total = sum(p["size"] for p in pieces)

        disk = boot_disk()
        if not disk:
            raise Failure("updating needs ASKus OS to be started from its USB stick")
        persist = persistence_partition(disk)
        if persist and total > persist[1] * 512:
            raise Failure("the new version is larger than the space reserved before your Persistent "
                          "Storage. Back up your Persistent folder and flash the new ISO with balenaEtcher.")

        # where to download
        if os.path.ismount(PERSIST_MNT) and shutil.disk_usage(PERSIST_MNT).free > total + 200e6:
            dest = os.path.join(PERSIST_MNT, ".askus-update")
            os.makedirs(dest, exist_ok=True)
        else:
            need = total + 64 * 1024 * 1024
            squash = os.path.getsize(SQUASHFS) if os.path.ismount(MEDIUM) else 0
            if mem_available() < need + squash + 700 * 1024 * 1024:
                raise Failure(f"not enough free memory to download the update "
                              f"(needs about {(need + squash + 700e6)/1e9:.1f} GB). Unlock your Persistent "
                              f"Storage at startup so the download can be stored there, or use a computer with more RAM.")
            dest = RAM_DIR
            os.makedirs(dest, exist_ok=True)
            if not os.path.ismount(dest):
                sh("mount", "-t", "tmpfs", "-o", f"size={need},mode=0700", "tmpfs", dest, check=True)
        # remove leftovers of older downloads
        for f in os.listdir(dest):
            if f not in {p["name"] for p in pieces} | {STATE_NAME}:
                os.remove(os.path.join(dest, f))

        download(pieces, dest, total)
        paths = [os.path.join(dest, p["name"]) for p in pieces]
        got = sha256_of_pieces(paths, total, "Checking the download (SHA-256)…", 60, 6)
        if got != expected:
            for p in paths + [os.path.join(dest, STATE_NAME)]:
                if os.path.exists(p):
                    os.remove(p)
            raise Failure("the download is damaged (checksum mismatch) and was deleted — try again")

        move_system_into_ram()

        # write the new image to the start of the stick
        write_status(state="running", step="Writing the new version to the USB stick — do not unplug it", progress=70)
        written = 0
        fd = os.open(disk, os.O_WRONLY)
        try:
            for path in paths:
                with open(path, "rb") as f:
                    while True:
                        b = f.read(CHUNK)
                        if not b:
                            break
                        os.write(fd, b)
                        written += len(b)
                        if written % (16 * CHUNK) < CHUNK:
                            os.fsync(fd)
                            write_status(state="running",
                                         step="Writing the new version to the USB stick — do not unplug it",
                                         progress=round(70 + 20 * written / total, 1))
            os.fsync(fd)
        finally:
            os.close(fd)

        # put the Persistent Storage entry back into the new partition table
        if persist:
            _, start, size = persist
            r = subprocess.run(["sfdisk", "--append", "--force", "--no-reread", "--no-tell-kernel", disk],
                               input=f"{start},{size},L\n", capture_output=True, text=True)
            if r.returncode != 0:
                raise Failure("the new version was written but the Persistent Storage entry could not be "
                              f"restored: {r.stderr.strip()}")

        # Read back and verify the system area. The partition table (first 34 sectors)
        # legitimately changes when the Persistent Storage entry is restored, so those
        # bytes are taken from the downloaded image and the boot code is compared separately.
        sh("sync")
        HEAD = 34 * 512
        with open(paths[0], "rb") as f:
            img_head = f.read(HEAD)
        h = hashlib.sha256()
        left = total
        first = True
        with open(disk, "rb", buffering=0) as f:
            while left > 0:
                b = f.read(min(CHUNK, left))
                if not b:
                    break
                if first:
                    if b[:446] != img_head[:446]:
                        raise Failure("verification of the USB stick failed (boot sector). Do not restart; "
                                      "try the update again, or flash the ISO with balenaEtcher")
                    b = img_head + b[HEAD:]
                    first = False
                h.update(b)
                left -= len(b)
                if (total - left) % (64 * CHUNK) < CHUNK:
                    write_status(state="running", step="Verifying the USB stick…",
                                 progress=round(90 + 9 * (total - left) / total, 1))
        if h.hexdigest() != expected:
            raise Failure("verification of the USB stick failed. Do not restart; try the update again, "
                          "or flash the ISO with balenaEtcher")

        for p in paths:
            os.remove(p)
        write_status(state="done", step=f"ASKus OS {tag} is installed. Restart to use it.", progress=100,
                     reboot=True, tag=tag)
        return 0
    except Failure as e:
        write_status(state="error", error=str(e), progress=0)
        return 1
    except Exception as e:  # noqa: BLE001
        write_status(state="error", error=f"unexpected error: {e}", progress=0)
        return 1


PREFETCH_STATUS = "/run/askus/prefetch.json"


def notify_user(title, body, action_label=None):
    """Desktop notification for the logged-in user; optional button that opens ASKus Update."""
    try:
        import pwd
        uid = pwd.getpwnam("askus").pw_uid
    except KeyError:
        return
    bus = f"/run/user/{uid}/bus"
    if not os.path.exists(bus):
        return
    ns = ["notify-send", "--app-name=ASKus Update", "--icon=askus-logo", title, body]
    if action_label:
        ns[1:1] = [f"--action=update={action_label}", "--action=later=Later"]
        script = 'a=$("$@"); [ "$a" = update ] && exec /usr/local/bin/askus-updater'
        cmd = ["runuser", "-u", "askus", "--", "env", f"DBUS_SESSION_BUS_ADDRESS=unix:path={bus}",
               f"XDG_RUNTIME_DIR=/run/user/{uid}", "sh", "-c", script, "sh"] + ns
    else:
        cmd = ["runuser", "-u", "askus", "--", "env", f"DBUS_SESSION_BUS_ADDRESS=unix:path={bus}"] + ns
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def cmd_prefetch():
    """Download a newer, correctly signed release into Persistent Storage in the background,
    so that "Update now" only has to write it to the stick. Runs from askus-update-prefetch.timer.
    Only when Persistent Storage is unlocked (never fills RAM), through Tor, gently (3 circuits)."""
    global STATUS
    if os.geteuid() != 0:
        sys.exit("must run as root")
    STATUS = PREFETCH_STATUS
    if not os.path.ismount(PERSIST_MNT):
        write_status(state="idle", step="Persistent Storage is locked - no background download")
        return 0
    if sh("systemctl", "is-active", "--quiet", "askus-update.service").returncode == 0:
        return 0
    try:
        cur = release_info()
        tag, published, assets = latest_release(cur["UPDATE_REPO"])
        if build_id_of(tag) <= build_id_of(cur["TAG"]):
            write_status(state="idle", step="up to date")
            return 0
        iso_name, pieces, sums = image_assets(assets)
        if not pieces:
            return 0
        expected = None
        for line in verified_sums(assets).splitlines():       # refuses unsigned / tampered releases
            f = line.split()
            if len(f) == 2 and f[1].lstrip("*") == iso_name:
                expected = f[0].lower()
        if not expected:
            return 0
        total = sum(p["size"] for p in pieces)
        if shutil.disk_usage(PERSIST_MNT).free < total + 500e6:
            write_status(state="idle", step="not enough space in Persistent Storage for a background download")
            return 0
        dest = os.path.join(PERSIST_MNT, ".askus-update")
        os.makedirs(dest, exist_ok=True)
        for f in os.listdir(dest):
            if f not in {p["name"] for p in pieces} | {STATE_NAME}:
                os.remove(os.path.join(dest, f))
        download(pieces, dest, total, workers=3, label="Downloading the update in the background")
        paths = [os.path.join(dest, p["name"]) for p in pieces]
        got = sha256_of_pieces(paths, total, "Checking the download…", 60, 6)
        if got != expected:
            for p in paths + [os.path.join(dest, STATE_NAME)]:
                if os.path.exists(p):
                    os.remove(p)
            write_status(state="error", error="background download was damaged and deleted; it will retry")
            return 1
        write_status(state="ready", step=f"{tag} downloaded and verified", latest=tag)
        notify_user("ASKus OS update ready",
                    f"{tag} has been downloaded and verified in the background. Installing it now only "
                    "takes a few minutes.", "Install now")
        return 0
    except Failure as e:
        write_status(state="error", error=str(e))
        return 1
    except Exception as e:  # noqa: BLE001
        write_status(state="error", error=f"{e.__class__.__name__}: {e}")
        return 1


def main():
    a = sys.argv[1:] or ["check"]
    if a[0] == "check":
        return cmd_check("--json" in a)
    if a[0] == "status":
        return cmd_status()
    if a[0] == "start":
        return cmd_start()
    if a[0] == "apply":
        return cmd_apply()
    if a[0] == "prefetch":
        return cmd_prefetch()
    sys.exit("usage: askus-update check [--json] | status | start | prefetch")


if __name__ == "__main__":
    sys.exit(main())

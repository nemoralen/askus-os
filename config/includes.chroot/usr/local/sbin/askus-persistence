#!/bin/bash
# ASKus OS — encrypted persistent storage on the boot USB (LUKS2 + ext4).
#   status | create | unlock | lock | finish
# Passphrases are read from stdin. create/unlock/lock only work while the Welcome
# screen is open (flag /run/askus/welcome-open), so apps can't use this later.
# "finish" closes the Welcome for good (/run/askus/welcome-closed is never removed).
set -euo pipefail

LABEL=ASKusPersistence
MAP=askus-persist
MNT=/run/askus/persistence
FLAG=/run/askus/welcome-open
CLOSED=/run/askus/welcome-closed
U=askus
H=/home/$U

# name : target : owner : mode
FEATURES=(
  "Persistent:$H/Persistent:user:0700"
  "gnupg:$H/.gnupg:user:0700"
  "electrum:$H/.electrum:user:0700"
  "keepassxc:$H/.config/keepassxc:user:0700"
  "ssh:$H/.ssh:user:0700"
  "thunderbird:$H/.thunderbird:user:0700"
  "network-connections:/etc/NetworkManager/system-connections:root:0700"
  "tor-bridges:/etc/tor/torrc.d:root:0755"
  "additional-software:/var/lib/askus/additional-software:root:0755"
  "askus-settings:$H/.config/askus:user:0700"
  "feather:$H/.config/feather:user:0700"
  "monero-wallets:$H/Monero:user:0700"
  "screenshots:$H/Pictures/Screenshots:user:0700"
)

die() { echo "error: $*" >&2; exit 1; }
welcome_open() { [ -e "$FLAG" ] && [ ! -e "$CLOSED" ]; }
need_flag() { welcome_open || die "persistent storage can only be changed from the Welcome screen at startup"; }
[ "$(id -u)" = 0 ] || die "must run as root (use pkexec)"

boot_disk() {
  local src pk
  src=$(findmnt -no SOURCE /run/live/medium 2>/dev/null || true)
  # Started with "toram": the stick is no longer mounted, find it by its volume label
  [ -n "$src" ] || src=$(blkid -t LABEL=ASKUS_OS -o device 2>/dev/null | grep -v '^/dev/sr' | head -n1)
  [ -n "$src" ] || return 1
  case "$src" in /dev/sr*|/dev/loop*) return 1;; esac
  pk=$(lsblk -no PKNAME "$src" 2>/dev/null | head -n1)
  [ -n "$pk" ] && echo "/dev/$pk"
}

# The first 4 GiB of the stick are reserved for the system image, so that a
# newer (bigger) ASKus OS can be written over it by askus-update without
# touching the Persistent Storage that follows.
RESERVED_SECTORS=$((4 * 1024 * 1024 * 2))

find_volume() {
  local disk=$1 p
  for p in $(lsblk -lnpo NAME,TYPE "$disk" | awk '$2=="part"{print $1}'); do
    if [ "$(blkid -s TYPE -o value "$p" 2>/dev/null)" = crypto_LUKS ] &&
       [ "$(blkid -s LABEL -o value "$p" 2>/dev/null)" = "$LABEL" ]; then echo "$p"; return 0; fi
  done
  return 1
}

# A leftover EMPTY partition behind the system area (e.g. from a "create" that stopped
# halfway) -> "device size_in_sectors". It has no file system and no encryption, so it holds
# no data; it is reused instead of reporting "not enough free space".
empty_part() {
  local disk=$1 p name start size
  for p in $(lsblk -lnpo NAME,TYPE "$disk" | awk '$2=="part"{print $1}'); do
    name=${p##*/}
    start=$(cat "/sys/class/block/$name/start" 2>/dev/null || echo 0)
    size=$(cat "/sys/class/block/$name/size" 2>/dev/null || echo 0)
    [ "$start" -ge "$RESERVED_SECTORS" ] || continue
    [ "$size" -ge $((1024*2048)) ] || continue
    [ -z "$(blkid -p -s TYPE -o value "$p" 2>/dev/null)" ] || continue    # has data / a file system
    echo "$p $size"; return 0
  done
  return 1
}

# Device node of partition number N of DISK (sda -> sda3, nvme0n1 -> nvme0n1p3)
part_by_number() {
  local disk=$1 n=$2 p
  for p in $(lsblk -lnpo NAME,TYPE "$disk" | awk '$2=="part"{print $1}'); do
    [ "$(cat "/sys/class/block/${p##*/}/partition" 2>/dev/null)" = "$n" ] && { echo "$p"; return 0; }
  done
  return 1
}

# Largest free region on the disk -> "start size" in 512-byte sectors (1 MiB aligned)
free_region() {
  sfdisk -F "$1" 2>/dev/null | awk -v min="$RESERVED_SECTORS" '
    /^ *[0-9]+ +[0-9]+ +[0-9]+ / { if ($3 > best) { best=$3; s=$1; e=$2 } }
    END { if (best) { a=int((s+2047)/2048)*2048; if (a<min) a=min; if (e>a) print a, e-a+1; } }'
}

read_pass() { IFS= read -r PASS || true; [ ${#PASS} -ge 8 ] || die "passphrase must be at least 8 characters"; }

# The targets in the home folder belong to the user. If any part of such a path were a
# symbolic link (e.g. ~/Persistent -> /usr/local/sbin), root would chown and mount over
# the link's target instead. So refuse links, and do the work in $H as the user.
no_symlinks() {
  local cur="" c parts
  IFS=/ read -ra parts <<<"${1#/}"
  for c in "${parts[@]}"; do
    cur="$cur/$c"
    [ -L "$cur" ] && die "refusing to use $cur: it is a symbolic link"
  done
  return 0
}

bind_features() {
  local f name target owner mode src
  for f in "${FEATURES[@]}"; do
    IFS=: read -r name target owner mode <<<"$f"
    src="$MNT/$name"
    no_symlinks "$target"
    mountpoint -q "$target" && continue
    if [ "$owner" = user ]; then
      runuser -u "$U" -- mkdir -p -- "$target"
      if [ ! -d "$src" ]; then
        mkdir -p "$src"; chown -h "$U:$U" "$src"
        runuser -u "$U" -- cp -a -- "$target/." "$src/" 2>/dev/null || true   # seed with current contents
      fi
      chown -h "$U:$U" "$src"
    else
      mkdir -p "$target"
      if [ ! -d "$src" ]; then
        mkdir -p "$src"
        cp -a "$target/." "$src/" 2>/dev/null || true        # seed with current contents
      fi
    fi
    chmod "$mode" "$src"
    no_symlinks "$target"      # check again right before mounting
    mount --bind "$src" "$target"
  done
  systemctl try-restart tor@default.service tor.service 2>/dev/null || true
  nmcli connection reload 2>/dev/null || true
  systemctl start --no-block askus-additional-software.service 2>/dev/null || true
}

open_and_mount() {
  local part=$1
  [ -e /dev/mapper/$MAP ] || printf '%s' "$PASS" | cryptsetup open --key-file=- "$part" $MAP ||
    die "wrong passphrase"
  mkdir -p "$MNT"
  mountpoint -q "$MNT" || { e2fsck -p /dev/mapper/$MAP >/dev/null 2>&1 || true
    mount -o noatime,nodev,nosuid /dev/mapper/$MAP "$MNT"; }
}

cmd=${1:-status}
case "$cmd" in
  status)
    disk=$(boot_disk || true)
    if [ -z "$disk" ]; then echo "medium=none"; exit 0; fi
    echo "medium=usb"; echo "disk=$disk"
    if vol=$(find_volume "$disk"); then echo "volume=$vol"; else echo "volume=none"
      read -r _ sz < <(free_region "$disk" || true) || true
      if [ "${sz:-0}" -lt $((1024*2048)) ]; then read -r _ sz < <(empty_part "$disk" || true) || true; fi
      echo "free_mb=$(( ${sz:-0} / 2048 ))"
    fi
    mountpoint -q "$MNT" && echo "unlocked=yes" || echo "unlocked=no"
    if welcome_open; then echo "welcome=open"; else echo "welcome=closed"; fi
    ;;
  create)
    need_flag
    disk=$(boot_disk) || die "persistent storage needs ASKus OS to be started from a USB stick"
    find_volume "$disk" >/dev/null && die "persistent storage already exists"
    read_pass
    if read -r part _ < <(empty_part "$disk"); then
      :   # reuse the empty partition left by an earlier attempt
    else
      read -r start size < <(free_region "$disk") || die "no free space on the USB stick"
      [ "$size" -ge $((1024*2048)) ] || die "need a USB stick of at least 6 GB (4 GB is reserved for the system and updates)"
      echo "$start,$size,L" | sfdisk --append --force --no-reread --no-tell-kernel "$disk" >/dev/null
      # number of the partition just added (the last one in the table)
      n=$(sfdisk -d "$disk" | awk '/^\/dev\//{d=$1} END{if (match(d, /[0-9]+$/)) print substr(d, RSTART)}')
      [ -n "$n" ] || die "could not read the new partition table"
      # The stick is in use (ASKus runs from it), so the kernel can't re-read the whole table.
      # Tell it about just the new partition instead.
      partx --add --nr "$n" "$disk" 2>/dev/null || partx --update --nr "$n" "$disk" 2>/dev/null || true
      udevadm settle; sleep 1
      part=$(part_by_number "$disk" "$n") || die "the new partition did not appear; please restart and try again (it will be reused)"
    fi
    printf '%s' "$PASS" | cryptsetup luksFormat --batch-mode --type luks2 --pbkdf argon2id \
        --label "$LABEL" --key-file=- "$part"
    printf '%s' "$PASS" | cryptsetup open --key-file=- "$part" $MAP
    mkfs.ext4 -q -L askus-data -m 0 /dev/mapper/$MAP
    mkdir -p "$MNT"; mount -o noatime,nodev,nosuid /dev/mapper/$MAP "$MNT"
    bind_features
    echo "created=$part"
    ;;
  unlock)
    need_flag
    disk=$(boot_disk) || die "not started from USB"
    part=$(find_volume "$disk") || die "no persistent storage found on this USB stick"
    read_pass
    open_and_mount "$part"
    bind_features
    echo "unlocked=yes"
    ;;
  lock)
    need_flag
    for f in "${FEATURES[@]}"; do
      IFS=: read -r _ target _ _ <<<"$f"
      no_symlinks "$target"
      umount "$target" 2>/dev/null || true
    done
    umount "$MNT" 2>/dev/null || true
    cryptsetup close $MAP 2>/dev/null || true
    echo "unlocked=no"
    ;;
  finish)
    touch "$CLOSED"; rm -f "$FLAG"; echo "welcome=closed" ;;
  *) die "usage: askus-persistence status|create|unlock|lock|finish" ;;
esac

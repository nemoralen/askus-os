#!/bin/bash
# ASKus OS — session admin helpers.
#   set-password   (stdin: password)  -> enables sudo for this session
#   set-lock-password (stdin: password) -> password for the lock screen (no admin rights)
#   set-time "YYYY-MM-DD HH:MM"       -> set the clock in UTC (Tor refuses to work with a wrong clock)
# All of them only work while the Welcome screen is open. Once it is closed, any app could
# otherwise call them through pkexec without a password.
set -euo pipefail
FLAG=/run/askus/welcome-open
CLOSED=/run/askus/welcome-closed   # one-way: once it exists, the Welcome can't be reopened
die() { echo "error: $*" >&2; exit 1; }
welcome_open() { [ -e "$FLAG" ] && [ ! -e "$CLOSED" ]; }
[ "$(id -u)" = 0 ] || die "must run as root (use pkexec)"
welcome_open || die "this can only be changed from the Welcome screen at startup"
case "${1:-}" in
  set-password)
    IFS= read -r PW || true
    [ ${#PW} -ge 6 ] || die "password must be at least 6 characters"
    printf 'askus:%s\n' "$PW" | chpasswd
    touch /run/askus/lock-password-set
    printf 'askus ALL=(ALL:ALL) ALL\n' > /etc/sudoers.d/askus-admin
    chmod 0440 /etc/sudoers.d/askus-admin
    usermod -aG sudo askus
    echo "admin=enabled"
    ;;
  set-lock-password)
    # Lets the session user choose the password the lock screen asks for. It gives no
    # admin rights. Once an administration password exists, the lock screen uses that one
    # and it can't be changed here (otherwise this would be a way to get admin rights).
    id -nG askus | tr ' ' '\n' | grep -qx sudo && die "the screen lock already uses your administration password"
    IFS= read -r PW || true
    [ ${#PW} -ge 4 ] || die "password must be at least 4 characters"
    printf 'askus:%s\n' "$PW" | chpasswd
    mkdir -p /run/askus && touch /run/askus/lock-password-set
    echo "lock=set"
    ;;
  set-time)
    [[ "${2:-}" =~ ^20[0-9]{2}-[01][0-9]-[0-3][0-9]\ [0-2][0-9]:[0-5][0-9]$ ]] || die "use the format YYYY-MM-DD HH:MM (UTC)"
    date -u -s "$2" >/dev/null   # system clock only - the hardware clock is left alone (Windows keeps it in local time)
    systemctl try-restart tor@default.service tor.service 2>/dev/null || true
    echo "time=$(date -u '+%Y-%m-%d %H:%M')"
    ;;
  *) die "usage: askus-admin set-password | set-lock-password | set-time 'YYYY-MM-DD HH:MM'" ;;
esac

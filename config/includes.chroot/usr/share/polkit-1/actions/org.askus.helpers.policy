<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ASKus OS</vendor>
  <action id="org.askus.persistence">
    <description>Manage ASKus OS persistent storage</description>
    <message>Persistent storage needs to be unlocked</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/askus-persistence</annotate>
  </action>
  <action id="org.askus.admin">
    <description>ASKus OS session administration</description>
    <message>Change session administration settings</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/askus-admin</annotate>
  </action>
  <action id="org.askus.bridges">
    <description>Configure Tor bridges</description>
    <message>Configure Tor bridges</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/askus-bridges</annotate>
  </action>
  <action id="org.askus.update">
    <description>Update ASKus OS</description>
    <message>Install the newest version of ASKus OS</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/askus-update</annotate>
  </action>
  <action id="org.askus.veracrypt">
    <description>Open VeraCrypt volumes</description>
    <message>Open a VeraCrypt volume</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/askus-veracrypt</annotate>
  </action>
  <action id="org.askus.additional-software">
    <description>Manage Additional Software</description>
    <message>Change which programs are reinstalled at startup</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/askus-additional-software</annotate>
  </action>
  <action id="org.askus.additional-software.install">
    <description>Install additional software</description>
    <message>Installing software needs the administration password</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/askus-additional-software-install</annotate>
  </action>
</policyconfig>
